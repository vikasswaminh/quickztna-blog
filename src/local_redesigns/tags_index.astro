---
import SiteLayout from "@/layouts/SiteLayout.astro";
import BlogHero from "@/components/blog/BlogHero.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

// Extract all tags and count frequencies with full metadata
const tagMap: Record<string, { count: number; posts: Array<{ title: string; slug: string; date: string; category: string; description: string }> }> = {};

for (const post of allPosts) {
  const slug = post.id.replace(/\.md$/, "");
  const tags = post.data.tags || [];
  for (const rawTag of tags) {
    const t = String(rawTag).toLowerCase().trim();
    if (!tagMap[t]) {
      tagMap[t] = { count: 0, posts: [] };
    }
    tagMap[t].count++;
    tagMap[t].posts.push({
      title: post.data.title,
      slug,
      date: post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
      category: post.data.category || "technical",
      description: post.data.description,
    });
  }
}

const allUniqueTags = Object.keys(tagMap).sort((a, b) => tagMap[b].count - tagMap[a].count || a.localeCompare(b));

// Top most explored tags
const topExploredTags = allUniqueTags.slice(0, 12);

function getTagCategory(tag: string): string {
  const posts = tagMap[tag]?.posts || [];
  if (posts.length === 0) return "technical";
  const counts: Record<string, number> = {};
  for (const p of posts) {
    const c = p.category || "technical";
    counts[c] = (counts[c] || 0) + 1;
  }
  return Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0] || "technical";
}

// Visual Domain Groups mapping existing tags
const topicGroups = [
  {
    id: "zero-trust",
    category: "post-quantum",
    name: "Zero Trust & Architecture",
    description: "NIST SP 800-207 principles, SDP, microsegmentation, and network access control.",
    badgeColor: "border-blue-200 bg-blue-50 text-blue-700",
    tags: ["zero-trust", "ztna", "nist-800-207", "beyondcorp", "software-defined-perimeter", "single-packet-authorization", "micro-segmentation", "least-privilege", "privileged-access", "jit-access"]
  },
  {
    id: "wireguard",
    category: "technical",
    name: "WireGuard & Kernel Networking",
    description: "Noise protocol handshakes, eBPF telemetry, STUN/DERP NAT traversal, and high-speed tunneling.",
    badgeColor: "border-cyan-200 bg-cyan-50 text-cyan-700",
    tags: ["wireguard", "wireguard-mesh", "noise-protocol", "nat-traversal", "ebpf", "openvpn", "ipsec", "masque", "http3", "netlink", "mesh-vpn"]
  },
  {
    id: "post-quantum",
    category: "post-quantum",
    name: "Post-Quantum Cryptography",
    description: "NIST FIPS 203/204/205 standards, ML-KEM Kyber, hybrid key exchanges, and HNDL defense.",
    badgeColor: "border-purple-200 bg-purple-50 text-purple-700",
    tags: ["post-quantum", "cryptography", "ml-kem", "fips-203", "hybrid-key-exchange", "x25519", "harvest-now-decrypt-later", "quantum-computing", "quantum-safe", "cnsa-2-0"]
  },
  {
    id: "compliance",
    category: "compliance",
    name: "Compliance & Regulatory Frameworks",
    description: "Practical technical implementations for SOC 2, HIPAA, EU NIS2, DORA, and ISO 27001.",
    badgeColor: "border-emerald-200 bg-emerald-50 text-emerald-700",
    tags: ["compliance", "soc-2", "hipaa", "nis2", "dora", "pci-dss", "iso-27001", "anssi", "bsi", "tr-02102", "eu-cybersecurity", "security-rule"]
  },
  {
    id: "identity",
    category: "fundamentals",
    name: "Identity, ABAC & Posture",
    description: "Attribute-Based Access Control, SCIM 2.0 provisioning, continuous device health checks, and SPIFFE.",
    badgeColor: "border-amber-200 bg-amber-50 text-amber-700",
    tags: ["abac", "iam", "rbac", "device-posture", "continuous-authentication", "scim-2-0", "spiffe", "multi-idp", "okta", "entra-id", "edr", "mdm"]
  },
  {
    id: "infrastructure",
    category: "industry",
    name: "Cloud, Kubernetes & DevOps",
    description: "Multi-cloud mesh, ephemeral CI/CD runners, Terraform automation, and database security.",
    badgeColor: "border-indigo-200 bg-indigo-50 text-indigo-700",
    tags: ["kubernetes", "cloud-security", "multi-cloud", "ci-cd", "ephemeral-runners", "terraform", "gitops", "infrastructure-as-code", "database-access", "secrets-management", "vault"]
  },
  {
    id: "comparisons",
    category: "comparison",
    name: "Comparisons & Migration Playbooks",
    description: "Total Cost of Ownership models, Cisco AnyConnect migration, Tailscale/Cloudflare teardowns.",
    badgeColor: "border-rose-200 bg-rose-50 text-rose-700",
    tags: ["comparison", "tailscale-alternative", "cloudflare-access-alternative", "twingate-alternative", "cisco-anyconnect", "ztna-vs-vpn", "total-cost", "self-host", "headscale", "netbird"]
  }
];

// Topic Learning Paths
const learningPaths = [
  {
    id: "ztna-foundation",
    title: "Zero Trust Architecture Roadmap",
    level: "Foundational to Advanced",
    description: "Step-by-step progression from core perimeter teardown to enterprise policy engines.",
    steps: [
      { num: "01", title: "What is Zero Trust Network Access?", slug: "what-is-ztna" },
      { num: "02", title: "Zero Trust vs Legacy VPN: Total Cost of Ownership", slug: "zero-trust-vs-vpn-cost-comparison" },
      { num: "03", title: "NIST SP 800-207 Zero Trust Architecture Guide", slug: "zero-trust-architecture-nist-800-207" },
      { num: "04", title: "Micro-Segmentation vs Traditional VLANs", slug: "micro-segmentation-vs-vlan" },
      { num: "05", title: "Least-Privilege Network Access Engineering", slug: "least-privilege-access-engineering" },
    ]
  },
  {
    id: "pqc-wireguard",
    title: "Quantum-Resistant WireGuard Blueprint",
    level: "Cryptographic Deep Dive",
    description: "Architectural path for deploying hybrid post-quantum key exchange in production.",
    steps: [
      { num: "01", title: "Harvest Now, Decrypt Later Threat Model", slug: "harvest-now-decrypt-later" },
      { num: "02", title: "NIST FIPS 203, 204 & 205 Complete Guide", slug: "nist-fips-203-204-205-guide" },
      { num: "03", title: "ML-KEM (Kyber) in WireGuard Noise Handshakes", slug: "ml-kem-kyber-wireguard" },
      { num: "04", title: "Hybrid Post-Quantum VPN Engineering", slug: "hybrid-post-quantum-vpn" },
    ]
  },
  {
    id: "compliance-blueprint",
    title: "Global Compliance & Risk Governance",
    level: "Regulatory Engineering",
    description: "Technical audit checklists and control mappings across international standards.",
    steps: [
      { num: "01", title: "SOC 2 Compliance via Zero Trust Controls", slug: "soc2-remote-access-controls" },
      { num: "02", title: "HIPAA-Compliant Remote Access in 2026", slug: "hipaa-compliant-vpn-2026" },
      { num: "03", title: "EU DORA Network Resilience Architecture", slug: "dora-compliance-network-resilience" },
      { num: "04", title: "PCI DSS 4.0 Cardholder Scope Reduction", slug: "pci-dss-4-zero-trust" },
    ]
  }
];

const tagsIndexSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Topic Explorer & Technical Tags — QuickZTNA Blog",
  description: "Explore all technical topics, architecture guides, protocol deep-dives, and compliance blueprints on the QuickZTNA blog.",
  url: "https://blog.quickztna.com/tags/",
};
---

<SiteLayout
  title="Topic Explorer — Browse Zero Trust & WireGuard Guides | QuickZTNA Blog"
  description="Explore all technical topics, architecture deep-dives, compliance standards, and WireGuard engineering guides across the QuickZTNA blog."
  canonical="https://blog.quickztna.com/tags/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(tagsIndexSchema)} is:inline />
  </Fragment>

  <!-- ── TAGS PAGE HERO (MATCHING HERO SIZE & CLEAN STRUCTURE) ── -->
  <section class="border-b border-border/70 bg-hero relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-85 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1700px] px-4 py-11 sm:py-13 lg:py-15">
      <div class="max-w-3xl space-y-3.5">
        <!-- Main H1 Heading -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[#0f172a] leading-[1.15]">
          Explore Every <span class="bg-gradient-to-r from-[#0066ff] to-[#00a3c4] bg-clip-text text-transparent">Topic & Tag</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="text-sm sm:text-base lg:text-lg text-[#475467] leading-relaxed max-w-2xl">
          Browse 45 engineering articles, architecture deep-dives, compliance frameworks, and tutorials organized by topic.
        </p>
      </div>
    </div>
  </section>

  <!-- ── STICKY CATEGORY & METRICS BAR (STAYS FIXED ON SCROLL) ──────── -->
  <div class="sticky top-16 z-30 border-b border-border/70 bg-white/95 backdrop-blur-md shadow-2xs transition-all">
    <div class="mx-auto max-w-[1700px] px-4 py-3 sm:px-6 lg:px-8 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <!-- Left: Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2" id="hero-category-bar">
        <button
          data-cat-pill="all"
          class="hero-cat-btn active rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] text-white px-4 py-1.5 text-xs font-bold shadow-sm transition-all duration-200 hover:brightness-105"
        >
          All Topics
        </button>
        <button
          data-cat-pill="post-quantum"
          class="hero-cat-btn rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-3.5 py-1.5 text-xs font-semibold hover:border-blue-300 transition-all"
        >
          Architecture
        </button>
        <button
          data-cat-pill="comparison"
          class="hero-cat-btn rounded-full border border-purple-200 bg-purple-50 text-purple-700 px-3.5 py-1.5 text-xs font-semibold hover:border-purple-300 transition-all"
        >
          Comparison
        </button>
        <button
          data-cat-pill="compliance"
          class="hero-cat-btn rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700 px-3.5 py-1.5 text-xs font-semibold hover:border-emerald-300 transition-all"
        >
          Compliance
        </button>
        <button
          data-cat-pill="technical"
          class="hero-cat-btn rounded-full border border-cyan-200 bg-cyan-50 text-cyan-700 px-3.5 py-1.5 text-xs font-semibold hover:border-cyan-300 transition-all"
        >
          Technical
        </button>
        <button
          data-cat-pill="fundamentals"
          class="hero-cat-btn rounded-full border border-amber-200 bg-amber-50 text-amber-800 px-3.5 py-1.5 text-xs font-semibold hover:border-amber-300 transition-all"
        >
          Fundamentals
        </button>
        <button
          data-cat-pill="industry"
          class="hero-cat-btn rounded-full border border-rose-200 bg-rose-50 text-rose-700 px-3.5 py-1.5 text-xs font-semibold hover:border-rose-300 transition-all"
        >
          Industry
        </button>
      </div>

      <!-- Right: Metric Count Pills matching screenshot -->
      <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground shrink-0">
        <div class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-white px-3 py-1 shadow-2xs">
          <span class="font-bold text-[#0066ff]">144</span>
          <span>Topics</span>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-white px-3 py-1 shadow-2xs">
          <span class="font-bold text-[#0066ff]">45</span>
          <span>Articles</span>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-white px-3 py-1 shadow-2xs">
          <span class="font-bold text-[#0066ff]">6</span>
          <span>Categories</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1700px] px-4 py-8 sm:px-6 lg:px-8 space-y-10">

    <!-- ── SECTION 3: MOST EXPLORED TOPICS (CLEAN BLACK TAG PILLS) ── -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground flex items-center gap-2">
          <span class="text-amber-500">🔥</span> MOST EXPLORED TOPICS
        </h3>
        <span class="text-xs text-muted-foreground font-mono">Ranked by deep-dive coverage</span>
      </div>

      <div class="flex flex-wrap gap-2.5">
        {topExploredTags.map((tag) => {
          const info = tagMap[tag];
          const cat = getTagCategory(tag);
          return (
            <a
              href={`/tags/${tag}/`}
              data-tag-cat={cat}
              class="top-tag-pill inline-flex items-center gap-2 rounded-xl border border-slate-300/90 bg-white hover:bg-slate-900 hover:border-slate-900 hover:text-white px-4 py-2 text-xs sm:text-sm font-bold text-slate-950 transition-all duration-150 hover:-translate-y-0.5 shadow-2xs group"
            >
              <span class="text-black group-hover:text-white">#{tag}</span>
              <span class="rounded-full bg-slate-100 group-hover:bg-slate-800 group-hover:text-white px-2 py-0.5 font-mono text-[11px] font-bold text-slate-700">
                {info?.count ?? 1}
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ── SECTION 4: VISUAL GROUPED TOPIC CARDS (SAME POSITION & LAYOUT) ── -->
    <section class="space-y-8" id="topic-groups-container">
      <div class="border-b border-border/60 pb-3 flex items-center justify-between">
        <h3 class="text-2xl font-extrabold tracking-tight text-foreground">
          Curated Topic Domains
        </h3>
        <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
          7 Architectural Focus Areas
        </span>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {topicGroups.map((group) => {
          const presentTags = group.tags.filter((t) => tagMap[t]);
          return (
            <div
              data-group-card={group.id}
              data-group-cat={group.category}
              class="topic-group-card flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-xs hover:border-primary/40 hover:shadow-md transition-all duration-200"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class={`rounded-full border px-3 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider ${group.badgeColor}`}>
                    {group.name}
                  </span>
                  <span class="font-mono text-xs text-muted-foreground">
                    {presentTags.length} topics
                  </span>
                </div>

                <p class="text-xs sm:text-sm text-muted-foreground mb-5 leading-relaxed">
                  {group.description}
                </p>

                <!-- Tag Pills inside Group Card (Clean Black Style) -->
                <div class="flex flex-wrap gap-2">
                  {presentTags.map((t) => {
                    const count = tagMap[t]?.count || 1;
                    return (
                      <a
                        href={`/tags/${t}/`}
                        data-tag-name={t}
                        class="tag-item inline-flex items-center gap-1.5 rounded-lg border border-slate-300/90 bg-white hover:bg-slate-900 hover:border-slate-900 hover:text-white px-3 py-1 text-xs font-mono font-semibold text-slate-950 transition-all group"
                      >
                        <span class="text-black group-hover:text-white">#{t}</span>
                        <span class="font-mono text-[10px] text-slate-700 bg-slate-100 group-hover:bg-slate-800 group-hover:text-white px-1.5 py-0.2 rounded font-bold">({count})</span>
                      </a>
                    );
                  })}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-border/60 flex items-center justify-between text-xs">
                <a
                  href={`/tags/${presentTags[0]}/`}
                  class="font-bold text-primary hover:underline inline-flex items-center gap-1"
                >
                  Explore {group.name.split("&")[0].trim()} →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- ── SECTION 5: TOPIC LEARNING PATHS ─────────────────────────── -->
    <section class="space-y-6 pt-6 border-t border-border/70">
      <div class="max-w-3xl">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          🎓 Structured Learning Curriculums
        </span>
        <h3 class="mt-1 text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Step-by-Step Architecture Progression
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-muted-foreground">
          Follow curated reading pathways from zero-trust fundamentals to advanced quantum cryptography and compliance.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {learningPaths.map((path) => (
          <div class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-xs hover:border-primary/40 transition-all">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-mono text-[10px] font-bold uppercase text-primary bg-primary/10 px-2.5 py-0.5 rounded-full">
                  {path.level}
                </span>
              </div>
              <h4 class="text-base font-bold text-foreground mb-2">
                {path.title}
              </h4>
              <p class="text-xs text-muted-foreground mb-4">
                {path.description}
              </p>

              <!-- Steps List -->
              <ol class="space-y-2.5 border-t border-border/50 pt-4">
                {path.steps.map((st) => (
                  <li>
                    <a
                      href={`/blog/${st.slug}/`}
                      class="group flex items-start gap-2.5 text-xs text-[#334155] hover:text-primary transition-colors"
                    >
                      <span class="font-mono font-bold text-primary/70 group-hover:text-primary shrink-0">
                        {st.num}
                      </span>
                      <span class="group-hover:underline line-clamp-2 leading-snug">
                        {st.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>

            <div class="mt-6 pt-3 border-t border-border/40">
              <a
                href={`/blog/${path.steps[0].slug}/`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline"
              >
                Start Curriculum →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SECTION 6: COMPLETE A-Z TAG DIRECTORY (CLEAN BLACK STYLING) ── -->
    <section class="space-y-6 pt-6 border-t border-border/70">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h3 class="text-xl font-bold text-foreground">
            Complete A–Z Tag Index ({allUniqueTags.length} Tags)
          </h3>
          <p class="text-xs text-muted-foreground">Alphabetical index across all published engineering articles</p>
        </div>
        <div class="font-mono text-xs text-muted-foreground bg-muted/40 px-3 py-1 rounded-full border border-border/60">
          A – Z Directory
        </div>
      </div>

      <div class="rounded-2xl border border-border/80 bg-white p-6 shadow-2xs">
        <div class="flex flex-wrap gap-2" id="all-tags-cloud">
          {allUniqueTags.map((tag) => {
            const count = tagMap[tag]?.count || 1;
            const cat = getTagCategory(tag);
            return (
              <a
                href={`/tags/${tag}/`}
                data-az-tag={tag}
                data-az-cat={cat}
                class="az-tag-pill inline-flex items-center gap-1.5 rounded-lg border border-slate-300/90 bg-white hover:bg-slate-900 hover:border-slate-900 hover:text-white px-2.5 py-1 text-xs font-mono font-semibold text-slate-950 transition-all duration-150 shadow-2xs group"
              >
                <span class="text-black group-hover:text-white">#{tag}</span>
                <span class="text-[10px] font-bold text-slate-700 bg-slate-100 group-hover:bg-slate-800 group-hover:text-white px-1.5 py-0.5 rounded">({count})</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

  </div>
</SiteLayout>

<script>
  function setupTagFilters() {
    const heroFilterBtns = document.querySelectorAll(".hero-cat-btn");
    const groupCards = document.querySelectorAll(".topic-group-card");
    const azTags = document.querySelectorAll(".az-tag-pill");
    const topTags = document.querySelectorAll(".top-tag-pill");

    const gradientClasses = ["bg-gradient-to-r", "from-[#0066ff]", "via-[#0088dd]", "to-[#00a3c4]", "text-white", "shadow-sm"];

    function applyCategory(cat: string) {
      // Filter Topic Group Cards
      groupCards.forEach((card) => {
        const el = card as HTMLElement;
        const groupId = el.getAttribute("data-group-card") || "";
        const groupCat = el.getAttribute("data-group-cat") || "";
        if (cat === "all" || groupId === cat || groupCat === cat || (cat === "post-quantum" && groupId === "zero-trust")) {
          el.style.display = "flex";
        } else if (cat === "comparison" && groupId === "comparisons") {
          el.style.display = "flex";
        } else if (cat === "compliance" && groupId === "compliance") {
          el.style.display = "flex";
        } else if (cat === "technical" && (groupId === "wireguard" || groupId === "infrastructure")) {
          el.style.display = "flex";
        } else if (cat === "fundamentals" && (groupId === "identity" || groupId === "zero-trust")) {
          el.style.display = "flex";
        } else if (cat === "industry" && groupId === "infrastructure") {
          el.style.display = "flex";
        } else {
          el.style.display = "none";
        }
      });

      // Filter Top Tags
      topTags.forEach((tagEl) => {
        const el = tagEl as HTMLElement;
        const tagCat = el.getAttribute("data-tag-cat") || "";
        if (cat === "all" || tagCat === cat) {
          el.style.display = "inline-flex";
        } else {
          el.style.display = "none";
        }
      });

      // Filter A-Z Tag Cloud
      azTags.forEach((tagEl) => {
        const el = tagEl as HTMLElement;
        const tagCat = el.getAttribute("data-az-cat") || "";
        if (cat === "all" || tagCat === cat) {
          el.style.display = "inline-flex";
        } else {
          el.style.display = "none";
        }
      });
    }

    heroFilterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        heroFilterBtns.forEach((b) => {
          b.classList.remove("active", ...gradientClasses);
          b.classList.add("border");
        });
        btn.classList.add("active", ...gradientClasses);
        btn.classList.remove("border");
        const cat = btn.getAttribute("data-cat-pill") || "all";
        applyCategory(cat);
      });
    });
  }

  setupTagFilters();
  document.addEventListener("astro:after-swap", setupTagFilters);
</script>
