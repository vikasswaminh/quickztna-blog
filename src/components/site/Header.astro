---
import Logo from "./Logo.astro";

const navLinks = [
  { href: "/", label: "Blog" },
  { href: "/tags/", label: "Tags" },
  { href: "/about/", label: "About" },
];

const externalLink = {
  href: "https://quickztna.com/",
  label: "quickztna.com",
};

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const cleanHref = href.replace(/\/$/, "") || "/";
  return cleanHref === "/" ? path === "/" : path === cleanHref || path.startsWith(cleanHref + "/");
};
---
<!-- Top Royal Blue Announcement Strip (Above Navigation Bar) -->
<aside class="relative z-50 w-full bg-[#0047BA] text-white transition-colors hover:bg-[#003EA8]">
  <div class="mx-auto flex max-w-[1440px] items-center justify-center px-4 py-2 text-center">
    <a
      href="https://quickztna.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 text-xs sm:text-[13px] font-medium leading-tight text-white transition-opacity hover:opacity-95"
    >
      <span class="inline-flex items-center justify-center rounded-[4px] bg-[#FFB800] px-2 py-0.5 text-[10.5px] font-extrabold uppercase tracking-wide text-slate-950 shadow-sm leading-none">
        NEW
      </span>
      <span class="inline-flex items-center gap-1.5 font-medium tracking-tight">
        <span class="hidden sm:inline">Free forever for up to 5 users · 100 devices · Kernel WireGuard mesh &amp; ABAC</span>
        <span class="sm:hidden">Free forever for 5 users · WireGuard mesh &amp; ABAC</span>
        <span class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span>
      </span>
    </a>
  </div>
</aside>

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Left: Logo pushed to left corner -->
    <div class="flex items-center">
      <a href="/" class="flex items-center">
        <Logo />
      </a>
    </div>

    <!-- Right: Desktop Nav + Gradient quickztna.com Button pushed to right side completely -->
    <div class="hidden items-center gap-6 sm:gap-8 md:flex">
      <nav class="flex items-center gap-6 sm:gap-7">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class={`text-[13.5px] font-semibold tracking-[-0.01em] transition-colors hover:text-primary ${
              isActive(l.href) ? "text-primary font-bold" : "text-[#475467]"
            }`}
          >
            {l.label}
          </a>
        ))}
      </nav>

      <a
        href={externalLink.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] hover:opacity-95 px-5 py-2 text-xs sm:text-sm font-bold text-white shadow-sm transition-all duration-200 hover:shadow-md hover:brightness-105 active:scale-[0.98]"
      >
        <span>{externalLink.label}</span>
        <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4.5 11.5L11.5 4.5M11.5 4.5H6.5M11.5 4.5V9.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Mobile hamburger (Optimized touch targets for Android & iOS) -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg p-2.5 text-[#475467] transition-colors hover:bg-muted hover:text-foreground active:scale-95"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-nav" class="hidden border-t border-border/60 bg-background md:hidden">
    <nav class="mx-auto max-w-7xl space-y-2 px-4 py-4 text-sm sm:px-6">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class={`block rounded-md px-3 py-2 font-bold transition-colors hover:bg-muted hover:text-[#00a3c4] ${
            isActive(l.href) ? "text-gradient" : "text-[#475467]"
          }`}
        >
          {l.label}
        </a>
      ))}
      <div class="pt-2">
        <a
          href={externalLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] hover:opacity-95 px-4 py-2.5 text-xs sm:text-sm font-bold text-white shadow-sm transition-all duration-150 active:scale-[0.98]"
        >
          <span>{externalLink.label}</span>
          <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4.5 11.5L11.5 4.5M11.5 4.5H6.5M11.5 4.5V9.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.getElementById("mobile-nav-toggle");
    const menu = document.getElementById("mobile-nav");
    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const nowOpen = menu.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(nowOpen));
      });
    }
  }
  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
