---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const latestPosts = posts.slice(0, 5);
---

<aside class="hidden lg:block w-full lg:w-64 xl:w-72 shrink-0">
  <div class="sticky top-24 space-y-6">
    <!-- Latest Posts Card -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-5 font-mono text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        Latest posts
      </p>
      <ul class="space-y-4">
        {latestPosts.map((post) => {
          const postDate = new Date(post.data.publishedAt || (post.data as any).pubDate || Date.now());
          return (
            <li>
              <a href={`/blog/${post.slug || post.id.replace(/\.md$/, '')}/`} class="group block">
                <h4 class="text-sm font-semibold leading-snug text-foreground group-hover:text-primary transition-colors line-clamp-2">
                  {post.data.title}
                </h4>
                <time
                  class="mt-1.5 block font-mono text-xs text-muted-foreground"
                  datetime={postDate.toISOString()}
                >
                  {postDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </time>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</aside>
