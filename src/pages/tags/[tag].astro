---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const tagMap = new Map<string, typeof allPosts>();

  for (const post of allPosts) {
    for (const tag of post.data.tags || []) {
      const normalized = tag.toLowerCase().trim();
      if (!normalized) continue;
      if (!tagMap.has(normalized)) {
        tagMap.set(normalized, []);
      }
      tagMap.get(normalized)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, posts]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;

const categoryLabel: Record<string, string> = {
  "post-quantum": "Architecture",
  compliance: "Compliance",
  comparison: "Comparison",
  fundamentals: "Fundamentals",
  technical: "Technical",
  industry: "Industry",
};

const categoryStyles: Record<string, { bg: string; text: string; border: string; tagBg: string; tagBorder: string; tagText: string }> = {
  "post-quantum": { bg: "bg-blue-50", text: "text-blue-700", border: "border-blue-200", tagBg: "bg-blue-50/70", tagBorder: "border-blue-200/80", tagText: "text-blue-800" },
  compliance: { bg: "bg-emerald-50", text: "text-emerald-700", border: "border-emerald-200", tagBg: "bg-emerald-50/70", tagBorder: "border-emerald-200/80", tagText: "text-emerald-800" },
  comparison: { bg: "bg-amber-50", text: "text-amber-800", border: "border-amber-200", tagBg: "bg-amber-50/70", tagBorder: "border-amber-200/80", tagText: "text-amber-900" },
  technical: { bg: "bg-purple-50", text: "text-purple-700", border: "border-purple-200", tagBg: "bg-purple-50/70", tagBorder: "border-purple-200/80", tagText: "text-purple-800" },
  fundamentals: { bg: "bg-cyan-50", text: "text-cyan-800", border: "border-cyan-200", tagBg: "bg-cyan-50/70", tagBorder: "border-cyan-200/80", tagText: "text-cyan-900" },
  industry: { bg: "bg-rose-50", text: "text-rose-700", border: "border-rose-200", tagBg: "bg-rose-50/70", tagBorder: "border-rose-200/80", tagText: "text-rose-800" },
};

const defaultStyle = {
  bg: "bg-slate-50",
  text: "text-slate-700",
  border: "border-slate-200",
  tagBg: "bg-slate-50",
  tagBorder: "border-slate-200",
  tagText: "text-slate-700",
};
---

<SiteLayout
  title={`Posts tagged #${tag} — QuickZTNA Blog`}
  description={`Explore all articles and guides related to #${tag} on the QuickZTNA engineering blog.`}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Header -->
    <div class="mb-10 text-center sm:text-left">
      <nav class="mb-4 flex items-center justify-center sm:justify-start gap-2 text-xs font-mono text-muted-foreground">
        <a href="/" class="hover:text-foreground">Home</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-foreground">Blog</a>
        <span>/</span>
        <a href="/tags/" class="hover:text-foreground">Tags</a>
        <span>/</span>
        <span class="text-primary font-bold">#{tag}</span>
      </nav>

      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#0f172a]">
          Articles tagged with <span class="text-[#1d6af3]">#{tag}</span>
        </h1>
        <span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 font-mono text-xs font-bold text-primary">
          {posts.length} {posts.length === 1 ? "article" : "articles"}
        </span>
      </div>

      <p class="mt-3 text-sm sm:text-base text-[#475467] leading-relaxed max-w-2xl">
        All technical teardowns, benchmarks, guides, and zero trust comparisons tagged with #{tag}.
      </p>
    </div>

    <!-- 2-Column Responsive Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => {
        const slug = post.id.replace(/\.md$/, "");
        const readTime = post.data.wordCount ? Math.ceil(post.data.wordCount / 200) : 12;
        const catStyle = categoryStyles[post.data.category] ?? defaultStyle;

        return (
          <article class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl hover:shadow-[#2563eb]/10 hover:border-[#3b82f6]">
            <div>
              <!-- Top Row: Category Badge (Left) & Read Time (Right) -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class={`rounded-full border ${catStyle.border} ${catStyle.bg} px-3 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider ${catStyle.text}`}>
                  {categoryLabel[post.data.category] ?? post.data.category}
                </span>
                <span class="font-mono text-xs text-[#64748b]">
                  {readTime} min
                </span>
              </div>

              <!-- Title -->
              <h2 class="text-xl font-bold tracking-tight leading-snug line-clamp-2">
                <a href={`/blog/${slug}/`} class="text-gradient hover:opacity-90 transition-opacity">
                  {post.data.title}
                </a>
              </h2>

              <!-- Description -->
              <p class="mt-3 text-sm text-[#475467] leading-relaxed line-clamp-2">
                {post.data.description}
              </p>
            </div>

            <div class="mt-5">
              <!-- Tags List -->
              <div class="flex flex-wrap gap-2 text-xs font-mono">
                {post.data.tags.slice(0, 4).map((t: string) => (
                  <a
                    href={`/tags/${encodeURIComponent(t.toLowerCase().trim())}/`}
                    class={`rounded-md border px-2 py-0.5 text-xs transition-colors ${
                      t.toLowerCase().trim() === tag
                        ? "border-[#1d6af3] bg-[#1d6af3] text-white font-bold"
                        : `${catStyle.tagBorder} ${catStyle.tagBg} ${catStyle.tagText} hover:brightness-95`
                    }`}
                  >
                    #{t}
                  </a>
                ))}
              </div>

              <!-- Date -->
              <time
                datetime={post.data.publishedAt.toISOString()}
                class="mt-3 block font-mono text-xs text-[#64748b]"
              >
                {post.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
              </time>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</SiteLayout>
