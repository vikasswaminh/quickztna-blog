---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const categoryLabel: Record<string, string> = {
  "post-quantum": "Architecture",
  comparison: "Comparison",
  compliance: "Compliance",
  technical: "Technical",
  fundamentals: "Fundamentals",
  industry: "Industry",
};

const categoryBadgeColors: Record<string, { bg: string; text: string; border: string; pillBg: string; dot: string }> = {
  "post-quantum": {
    bg: "bg-blue-50",
    text: "text-blue-700",
    border: "border-blue-200",
    pillBg: "bg-blue-50/60 hover:bg-blue-100/70 hover:border-blue-300 hover:text-blue-800",
    dot: "#2563eb",
  },
  comparison: {
    bg: "bg-purple-50",
    text: "text-purple-700",
    border: "border-purple-200",
    pillBg: "bg-purple-50/60 hover:bg-purple-100/70 hover:border-purple-300 hover:text-purple-800",
    dot: "#8b5cf6",
  },
  compliance: {
    bg: "bg-emerald-50",
    text: "text-emerald-700",
    border: "border-emerald-200",
    pillBg: "bg-emerald-50/60 hover:bg-emerald-100/70 hover:border-emerald-300 hover:text-emerald-800",
    dot: "#10b981",
  },
  technical: {
    bg: "bg-cyan-50",
    text: "text-cyan-700",
    border: "border-cyan-200",
    pillBg: "bg-cyan-50/60 hover:bg-cyan-100/70 hover:border-cyan-300 hover:text-cyan-800",
    dot: "#06b6d4",
  },
  fundamentals: {
    bg: "bg-amber-50",
    text: "text-amber-700",
    border: "border-amber-200",
    pillBg: "bg-amber-50/60 hover:bg-amber-100/70 hover:border-amber-300 hover:text-amber-800",
    dot: "#f59e0b",
  },
  industry: {
    bg: "bg-rose-50",
    text: "text-rose-700",
    border: "border-rose-200",
    pillBg: "bg-rose-50/60 hover:bg-rose-100/70 hover:border-rose-300 hover:text-rose-800",
    dot: "#f43f5e",
  },
};

const getCatColor = (cat: string) =>
  categoryBadgeColors[cat] ?? {
    bg: "bg-primary/10",
    text: "text-primary",
    border: "border-primary/20",
    pillBg: "bg-muted/60 hover:bg-primary/5 hover:border-primary/40 hover:text-primary",
    dot: "#1d6af3",
  };

const categories = ["post-quantum", "comparison", "compliance", "technical", "fundamentals", "industry"] as const;

// Category post counts
const counts = Object.fromEntries(
  categories.map((c) => [c, allPosts.filter((p) => p.data.category === c).length])
);

// Featured post (latest/first) and remaining posts
const featured = allPosts[0];
const restPosts = allPosts.slice(1);

// Recent updates for the right sidebar (top 6 newest)
const recentUpdates = allPosts.slice(0, 7);

// Curated highlights for the left sidebar (7 core articles)
const founderSpecials = [
  allPosts.find((p) => p.id.includes("ztna-vs-vpn")) || allPosts[0],
  allPosts.find((p) => p.id.includes("wireguard-mesh-network")) || allPosts[1],
  allPosts.find((p) => p.id.includes("outbound-only-zero-trust")) || allPosts[2],
  allPosts.find((p) => p.id.includes("identity-first-networking")) || allPosts[3],
  allPosts.find((p) => p.id.includes("device-posture-checks")) || allPosts[4],
  allPosts.find((p) => p.id.includes("kubernetes-zero-trust")) || allPosts[5],
  allPosts.find((p) => p.id.includes("sase-vs-ztna-vs-sse")) || allPosts[6],
];

const blogIndexSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://blog.quickztna.com/blog/",
  url: "https://blog.quickztna.com/blog/",
  name: "QuickZTNA Blog",
  description: "Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team.",
  publisher: { "@id": "https://blog.quickztna.com/#organization" },
  inLanguage: "en",
  blogPost: allPosts.slice(0, 20).map((p) => {
    const slug = p.id.replace(/\.md$/, "");
    return {
      "@type": "BlogPosting",
      headline: p.data.title,
      description: p.data.description,
      url: `https://blog.quickztna.com/blog/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      dateModified: (p.data.updatedAt ?? p.data.publishedAt).toISOString(),
      author: { "@type": "Person", name: p.data.author.name },
    };
  }),
};

const blogBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://blog.quickztna.com" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://blog.quickztna.com/blog/" },
  ],
};
---

<SiteLayout
  title="QuickZTNA Blog — Zero Trust, WireGuard Mesh & Cloud Security"
  description="Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team on Zero Trust Network Access, WireGuard mesh, and cloud security."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogIndexSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(blogBreadcrumbSchema)} is:inline />
  </Fragment>

  <!-- Main 3-Column Page Layout Container (1440px max width for optimal clarity & reading density) -->
  <div class="mx-auto max-w-[1440px] px-3 sm:px-5 lg:px-6 py-6 sm:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_1fr] xl:grid-cols-[16.5rem_1fr_17rem] gap-6 sm:gap-7 items-start">

      <!-- ── LEFT SIDEBAR (STICKY ON SCROLL - OLLAGRAPH FLAGSHIP NUMBERED STYLE) ── -->
      <aside class="w-full lg:w-[16rem] xl:w-[16.5rem] space-y-5 order-2 lg:order-1 lg:sticky lg:top-20 self-start">
        <div class="p-1 sm:p-2">
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-border/80">
            <span class="rounded-md bg-amber-500/10 border border-amber-500/20 text-amber-700 px-2.5 py-0.5 font-mono text-[10.5px] font-bold uppercase tracking-wider">
              FOUNDER SPECIAL
            </span>
            <span class="font-mono text-xs font-semibold text-muted-foreground">
              {founderSpecials.length} articles
            </span>
          </div>

          <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
            Core Architectures
          </p>

          <ul class="space-y-2.5">
            {founderSpecials.map((post, idx) => {
              const slug = post.id.replace(/\.md$/, "");
              const catCol = getCatColor(post.data.category);
              const num = String(idx + 1).padStart(2, "0");
              return (
                <li class="border-b border-border/50 pb-2.5 last:border-0 last:pb-0">
                  <a href={`/blog/${slug}/`} class="group flex items-start gap-2.5 text-decoration-none">
                    <span class="popular-num pt-0.5">
                      {num}
                    </span>
                    <div class="flex flex-col gap-1 min-w-0">
                      <h4 class="text-xs font-semibold leading-[1.38] line-clamp-2 text-foreground group-hover:text-primary transition-colors">
                        {post.data.title}
                      </h4>
                      <div class="flex items-center gap-1.5 text-[10.5px] text-muted-foreground">
                        <span class="h-1.5 w-1.5 rounded-full shrink-0" style={`background-color: ${catCol.dot};`}></span>
                        <span>{post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
                        <span class="opacity-50">·</span>
                        <span>{post.data.wordCount ? `${Math.round(post.data.wordCount / 200)}m read` : "8m read"}</span>
                      </div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>

          <a href="#posts-grid" class="mt-3.5 inline-block font-mono text-xs font-bold text-primary hover:underline">
            View All Specials →
          </a>
        </div>
      </aside>

      <!-- ── CENTER SCROLLING BLOG FEED ─────────────────────────────── -->
      <main class="min-w-0 space-y-6 order-1 lg:order-2">
        
        <!-- Center Title Header (Clean, high-clarity typography) -->
        <div class="border-b border-border/80 pb-4">
          <h1 class="text-2xl sm:text-3xl lg:text-[2.2rem] font-extrabold tracking-[-0.03em] text-foreground">
            Quick<span class="text-gradient">ZTNA</span> <span class="text-gradient">Blog</span>
          </h1>
          <p class="mt-1.5 text-xs sm:text-sm text-muted-foreground max-w-2xl leading-relaxed">
            Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team.
          </p>
          
          <div class="mt-3.5 flex items-center gap-2">
            <span class="rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-3.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-white shadow-2xs">
              🔥 NEWEST ARTICLES
            </span>
            <span class="text-xs text-muted-foreground font-medium">
              Latest from our security architects
            </span>
          </div>
        </div>

        <!-- ── FEATURED TOP HERO CARD (HIGH CLARITY 2-COL TOPOLOGY) ──── -->
        {featured && (() => {
          const fSlug = featured.id.replace(/\.md$/, "");
          const fColor = getCatColor(featured.data.category);
          return (
            <article class="featured-card-nh group overflow-hidden">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch">
                <!-- Left Visual Graphic Box -->
                <div class="md:col-span-5 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 p-6 flex flex-col justify-between relative overflow-hidden min-h-[220px]">
                  <div class="absolute inset-0 bg-grid opacity-25 pointer-events-none" aria-hidden="true"></div>
                  
                  <!-- Top Status Pill -->
                  <div class="relative z-10 flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-300">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      ACTIVE MESH
                    </span>
                    <span class="font-mono text-[10px] text-slate-400">P2P v2.4</span>
                  </div>

                  <!-- Center Graphic Icon / Topology Display -->
                  <div class="relative z-10 my-4 flex items-center justify-center">
                    <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-primary to-[#00a3c4] p-0.5 shadow-lg group-hover:scale-105 transition-transform duration-300">
                      <div class="h-full w-full rounded-[14px] bg-slate-900 flex items-center justify-center">
                        <svg class="h-8 w-8 text-[#00a3c4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="2" y="2" width="20" height="8" rx="2" stroke-linecap="round"/>
                          <rect x="2" y="14" width="20" height="8" rx="2" stroke-linecap="round"/>
                          <path d="M6 6h.01M6 18h.01" stroke-linecap="round"/>
                          <path d="M12 10v4" stroke-linecap="round" stroke-dasharray="2 2"/>
                        </svg>
                      </div>
                    </div>
                  </div>

                  <!-- Bottom Tagline -->
                  <div class="relative z-10 flex items-center justify-between text-[11px] font-mono text-slate-300">
                    <span>WireGuard ABAC</span>
                    <span class="text-primary font-bold">100% Zero-Trust</span>
                  </div>
                </div>

                <!-- Right Content Box -->
                <div class="md:col-span-7 p-6 sm:p-7 flex flex-col justify-between bg-card">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class={`rounded-md border ${fColor.border} ${fColor.bg} px-2.5 py-0.5 font-semibold text-xs ${fColor.text}`}>
                        {categoryLabel[featured.data.category]}
                      </span>
                      <span class="rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase">
                        ⚡ FEATURED
                      </span>
                    </div>

                    <a href={`/blog/${fSlug}/`} class="block group">
                      <h2 class="text-lg sm:text-xl font-extrabold leading-snug tracking-[-0.02em] text-foreground group-hover:text-primary transition-colors">
                        {featured.data.title}
                      </h2>
                    </a>

                    <p class="mt-2.5 text-xs sm:text-sm text-muted-foreground line-clamp-3 leading-relaxed">
                      {featured.data.description}
                    </p>
                  </div>

                  <div class="mt-5 pt-3.5 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground">
                    <div class="flex items-center gap-1.5 font-mono text-[11px]">
                      <svg class="h-3 w-3 text-muted-foreground/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      <span>{featured.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                      <span class="opacity-40">·</span>
                      <span>{featured.data.wordCount ? `${Math.round(featured.data.wordCount / 200)} min read` : "8 min read"}</span>
                    </div>
                    <a href={`/blog/${fSlug}/`} class="font-bold text-primary group-hover:underline inline-flex items-center gap-1">
                      <span>Read article</span>
                      <span class="card-arrow">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })()}

        <!-- ── STICKY FULL-WIDTH CATEGORY FILTER TOOLBAR (OLLAGRAPH PILL CLARITY) ── -->
        <div class="sticky top-16 z-30 -mx-2 px-2 py-3 bg-background/95 backdrop-blur-md border-b border-border/80">
          <div class="filter-pills-bar overflow-x-auto pb-1 sm:pb-0" id="pill-filters" role="tablist" aria-label="Filter by category">
            <button
              data-pill="all"
              class="filter-pill pill-btn active"
              role="tab"
              aria-selected="true"
            >
              <span class="pill-dot bg-[#0066ff]"></span>
              <span>All</span>
              <span class="pill-badge">{allPosts.length}</span>
            </button>
            {categories.map((c) => {
              const catColor = getCatColor(c);
              return counts[c] > 0 && (
                <button
                  data-pill={c}
                  class="filter-pill pill-btn"
                  role="tab"
                  aria-selected="false"
                >
                  <span class="pill-dot" style={`background-color: ${catColor.dot};`}></span>
                  <span>{categoryLabel[c]}</span>
                  <span class="pill-badge">{counts[c]}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- ── MAIN POSTS GRID (CRISP 2-3 COLUMN CARDS) ──────────────── -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5" id="posts-grid">
          {restPosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const catColor = getCatColor(post.data.category);
            const tagsStr = (post.data.tags ?? []).join(" ");
            return (
              <article
                class="post-item post-card group p-5 sm:p-5.5"
                data-post-cat={post.data.category}
                data-tags={tagsStr}
              >
                <div>
                  <!-- Category tag & Date with SVG icon -->
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class={`rounded-md border ${catColor.border} ${catColor.bg} px-2 py-0.5 font-semibold text-[11px] ${catColor.text}`}>
                      {categoryLabel[post.data.category]}
                    </span>
                    <div class="flex items-center gap-1 font-mono text-[10.5px] text-muted-foreground">
                      <svg class="h-3 w-3 text-muted-foreground/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                      </time>
                    </div>
                  </div>

                  <!-- Title with crisp tracking & line-clamp -->
                  <a href={`/blog/${slug}/`} class="block group">
                    <h3 class="post-card-title line-clamp-2">
                      {post.data.title}
                    </h3>
                  </a>

                  <!-- Excerpt snippet -->
                  <p class="post-card-desc mt-2 line-clamp-2">
                    {post.data.description}
                  </p>
                </div>

                <!-- Footer with read link & SVG clock -->
                <div class="post-card-meta">
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3 w-3 text-primary/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>{post.data.wordCount ? `${Math.round(post.data.wordCount / 200)} min read` : "8 min read"}</span>
                  </span>
                  <span class="meta-sep text-border">·</span>
                  <a href={`/blog/${slug}/`} class="font-bold text-primary group-hover:underline inline-flex items-center gap-1 ml-auto">
                    <span>Read article</span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- No posts empty state -->
        <div id="no-posts" class="hidden rounded-2xl border border-dashed border-border py-12 text-center">
          <p class="text-sm font-semibold text-muted-foreground">No articles found in this category.</p>
          <button
            id="reset-filter-btn"
            class="mt-3 rounded-md bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90"
          >
            Show all articles
          </button>
        </div>
      </main>

      <!-- ── RIGHT SIDEBAR (STICKY ON SCROLL - NEWEST ARTICLES NUMBERED LIST) ─ -->
      <aside class="w-full xl:w-[17rem] space-y-5 order-3 xl:sticky xl:top-20 self-start hidden xl:block">
        
        <div class="p-1 sm:p-2">
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-border/80">
            <span class="rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-3 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-white shadow-xs">
              NEWEST ARTICLES
            </span>
            <span class="font-mono text-xs font-semibold text-muted-foreground">
              {allPosts.length} articles
            </span>
          </div>

          <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
            Recent updates
          </p>

          <ul class="space-y-2.5">
            {recentUpdates.map((p, idx) => {
              const pSlug = p.id.replace(/\.md$/, "");
              const pCol = getCatColor(p.data.category);
              const num = String(idx + 1).padStart(2, "0");
              return (
                <li class="border-b border-border/50 pb-2.5 last:border-0 last:pb-0">
                  <a href={`/blog/${pSlug}/`} class="group flex items-start gap-2.5 text-decoration-none">
                    <span class="popular-num pt-0.5">
                      {num}
                    </span>
                    <div class="flex flex-col gap-1 min-w-0">
                      <h4 class="text-xs font-semibold leading-[1.38] line-clamp-2 text-foreground group-hover:text-primary transition-colors">
                        {p.data.title}
                      </h4>
                      <div class="flex items-center gap-1.5 text-[10.5px] text-muted-foreground">
                        <span class="h-1.5 w-1.5 rounded-full shrink-0" style={`background-color: ${pCol.dot};`}></span>
                        <span>{p.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
                        <span class="opacity-50">·</span>
                        <span class="font-medium text-primary group-hover:underline">Read →</span>
                      </div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>

          <a href="#posts-grid" class="mt-3.5 inline-block font-mono text-xs font-bold text-primary hover:underline">
            View All Specials →
          </a>
        </div>

        <!-- Cloud Mesh Quick Install Card -->
        <div class="rounded-2xl bg-primary/5 p-5 border border-primary/15 shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="h-2 w-2 rounded-full bg-success animate-pulse"></span>
            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-foreground">Global Mesh</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Connect servers, databases, and developers in &lt; 2 minutes.
          </p>
          <div class="mt-3 rounded-xl bg-muted/80 p-3 font-mono text-[11px] text-foreground border border-border/80 select-all overflow-x-auto">
            curl -fsSL https://login.quickztna.com/install.sh | sh
          </div>
        </div>
      </aside>

    </div>
  </div>
</SiteLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-item {
    animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  function setupBlogFiltering() {
    const noPostsEl = document.getElementById("no-posts");
    const resetBtn = document.getElementById("reset-filter-btn");

    const topicButtons = document.querySelectorAll<HTMLButtonElement>("[data-topic]");
    const pillButtons = document.querySelectorAll<HTMLButtonElement>("[data-pill]");
    const postItems = document.querySelectorAll<HTMLElement>(".post-item");

    let currentFilterType = "all"; // "all" | "category" | "tag"
    let currentFilterVal = "all";

    function filterPosts() {
      let visibleCount = 0;

      postItems.forEach((item) => {
        const postCat = item.dataset.postCat || "";
        const tags = item.dataset.tags || "";

        let matchesFilter = true;
        if (currentFilterType === "category") {
          matchesFilter = currentFilterVal === "all" || postCat === currentFilterVal;
        } else if (currentFilterType === "tag") {
          matchesFilter = currentFilterVal === "all" || tags.includes(currentFilterVal);
        }

        if (matchesFilter) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      if (noPostsEl) {
        noPostsEl.classList.toggle("hidden", visibleCount > 0);
      }
    }

    function setFilter(type: "all" | "category" | "tag", val: string) {
      currentFilterType = type;
      currentFilterVal = val;

      // Update Left Sidebar Topic Buttons
      topicButtons.forEach((btn) => {
        const cat = btn.dataset.topic;
        const isActive = (type === "category" && cat === val) || (type === "all" && cat === "all");
        btn.classList.toggle("active", isActive);
      });

      // Update Middle Pill Buttons
      pillButtons.forEach((btn) => {
        const pillCat = btn.dataset.pill;
        const isActive = (type === "category" && pillCat === val) || (type === "all" && pillCat === "all");
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      filterPosts();
    }

    topicButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.topic ?? "all";
        if (cat === "all") {
          setFilter("all", "all");
        } else {
          setFilter("category", cat);
        }
      });
    });

    pillButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.pill ?? "all";
        if (cat === "all") {
          setFilter("all", "all");
        } else {
          setFilter("category", cat);
        }
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        setFilter("all", "all");
      });
    }

    // Check query param
    const params = new URLSearchParams(window.location.search);
    const initialCat = params.get("category");
    const initialTag = params.get("tag");
    if (initialTag) {
      setFilter("tag", initialTag);
    } else if (initialCat) {
      setFilter("category", initialCat);
    }
  }

  setupBlogFiltering();
  document.addEventListener("astro:after-swap", setupBlogFiltering);
</script>
