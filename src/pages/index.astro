---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const categoryLabel: Record<string, string> = {
  "post-quantum": "Architecture",
  compliance: "Compliance",
  comparison: "Comparison",
  fundamentals: "Fundamentals",
  technical: "Technical",
  industry: "Industry",
};

const categoryBadgeColors: Record<string, { bg: string; text: string; border: string; pillBg: string }> = {
  "post-quantum": {
    bg: "bg-blue-50",
    text: "text-blue-700",
    border: "border-blue-200",
    pillBg: "bg-blue-50/60 hover:bg-blue-100/70 hover:border-blue-300 hover:text-blue-800",
  },
  comparison: {
    bg: "bg-purple-50",
    text: "text-purple-700",
    border: "border-purple-200",
    pillBg: "bg-purple-50/60 hover:bg-purple-100/70 hover:border-purple-300 hover:text-purple-800",
  },
  compliance: {
    bg: "bg-emerald-50",
    text: "text-emerald-700",
    border: "border-emerald-200",
    pillBg: "bg-emerald-50/60 hover:bg-emerald-100/70 hover:border-emerald-300 hover:text-emerald-800",
  },
  technical: {
    bg: "bg-cyan-50",
    text: "text-cyan-700",
    border: "border-cyan-200",
    pillBg: "bg-cyan-50/60 hover:bg-cyan-100/70 hover:border-cyan-300 hover:text-cyan-800",
  },
  fundamentals: {
    bg: "bg-amber-50",
    text: "text-amber-700",
    border: "border-amber-200",
    pillBg: "bg-amber-50/60 hover:bg-amber-100/70 hover:border-amber-300 hover:text-amber-800",
  },
  industry: {
    bg: "bg-rose-50",
    text: "text-rose-700",
    border: "border-rose-200",
    pillBg: "bg-rose-50/60 hover:bg-rose-100/70 hover:border-rose-300 hover:text-rose-800",
  },
};

const getCatColor = (cat: string) =>
  categoryBadgeColors[cat] ?? {
    bg: "bg-primary/10",
    text: "text-primary",
    border: "border-primary/20",
    pillBg: "bg-muted/60 hover:bg-primary/5 hover:border-primary/40 hover:text-primary",
  };

const categories = ["post-quantum", "comparison", "compliance", "technical", "fundamentals", "industry"] as const;

// Category post counts
const counts = Object.fromEntries(
  categories.map((c) => [c, allPosts.filter((p) => p.data.category === c).length])
);

// Featured post (latest/first) and rest of the posts
const featured = allPosts[0];
const restPosts = allPosts.slice(1);

// Latest posts for top highlight section
const latestPosts = allPosts.slice(0, 8);

const blogIndexSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.quickztna.com/blog/",
  url: "https://www.quickztna.com/blog/",
  name: "QuickZTNA Blog",
  description: "Guides, tips, and product updates from the QuickZTNA team.",
  publisher: { "@id": "https://www.quickztna.com/#organization" },
  inLanguage: "en",
  blogPost: allPosts.slice(0, 20).map((p) => {
    const slug = p.id.replace(/\.md$/, "");
    return {
      "@type": "BlogPosting",
      headline: p.data.title,
      description: p.data.description,
      url: `https://www.quickztna.com/blog/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      dateModified: (p.data.updatedAt ?? p.data.publishedAt).toISOString(),
      author: { "@type": "Person", name: p.data.author.name },
    };
  }),
};

const blogBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.quickztna.com" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://www.quickztna.com/blog/" },
  ],
};
---

<SiteLayout
  title="QuickZTNA Blog — Guides, Tips, and Product Updates"
  description="Guides, tips, and product updates from the QuickZTNA team on Zero Trust Network Access, WireGuard mesh, and cybersecurity."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogIndexSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(blogBreadcrumbSchema)} is:inline />
  </Fragment>

  <!-- ── HERO BANNER ────────────────────────────────────────────────── -->
  <section class="border-b border-border/70 bg-hero relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-85 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1700px] px-4 py-10 sm:py-12 lg:py-14 text-center flex flex-col items-center justify-center">
      <!-- Badge -->
      <span class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-card/90 px-3.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider mb-3 shadow-xs">
        <span class="text-[#334155]">ENGINEERING &</span>
        <span class="text-gradient">RESEARCH</span>
      </span>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-foreground leading-[1.15]">
        Quick<span class="text-gradient">ZTNA</span> <span class="text-gradient">Blog</span>
      </h1>
      <p class="mt-2.5 max-w-2xl text-base sm:text-lg text-muted-foreground leading-relaxed">
        Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team.
      </p>
    </div>
  </section>

  <!-- Layout Container -->
  <div class="mx-auto max-w-[1550px] px-3 sm:px-5 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[17rem_1fr] gap-6 xl:gap-8 items-start">

      <!-- ── LEFT SIDEBAR (STICKY FIXED ON SCROLL - 17rem width) ───── -->
      <aside class="w-full lg:w-[17rem] space-y-5 order-2 lg:order-1 lg:sticky lg:top-20 self-start">
        <!-- Free Forever Card -->
        <div class="rounded-xl border border-border/80 bg-card p-5 shadow-xs transition-all duration-300 hover:shadow-md hover:border-primary/40">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
            FREE FOREVER
          </p>
          <h2 class="mt-2 text-sm font-bold leading-snug text-foreground">
            ZTNA mesh for your whole team
          </h2>
          <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
            WireGuard mesh + ABAC policy + DNS threat filtering. One install command. No card.
          </p>
          <a
            href="https://login.quickztna.com/auth"
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-4 flex w-full items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] hover:opacity-95 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-all duration-200 hover:shadow-md hover:brightness-105 active:scale-[0.98]"
          >
            <span>Start free</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1 font-black">→</span>
          </a>
        </div>

        <!-- Browse By Topic Card -->
        <div class="rounded-xl border border-border/80 bg-card p-5 shadow-xs transition-all duration-300 hover:shadow-md hover:border-primary/40">
          <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
            BROWSE BY TOPIC
          </p>
          <div class="space-y-1.5" id="topic-list">
            <button
              data-topic="all"
              class="topic-btn active flex w-full items-center justify-between rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-4 py-2 text-xs font-bold text-white shadow-sm transition-all duration-150 text-left"
            >
              <span>All posts</span>
              <span class="font-mono text-[11px] opacity-90">{allPosts.length}</span>
            </button>
            {categories.map((c) => {
              const catColor = getCatColor(c);
              return counts[c] > 0 && (
                <button
                  data-topic={c}
                  class="topic-btn flex w-full items-center justify-between rounded-full px-4 py-2 text-xs font-semibold text-foreground/80 hover:bg-primary/5 hover:text-primary transition-all duration-150 text-left group"
                >
                  <div class="flex items-center gap-2">
                    <span class={`h-2 w-2 rounded-full ${catColor.bg} border ${catColor.border} group-hover:scale-110 transition-transform`}></span>
                    <span>{categoryLabel[c]}</span>
                  </div>
                  <span class="font-mono text-[11px] text-muted-foreground">{counts[c]}</span>
                </button>
              );
            })}
          </div>
        </div>
      </aside>

      <!-- ── CENTER SCROLLING BLOG FEED ────────────────────────────── -->
      <main class="min-w-0 space-y-6 order-1 lg:order-2">
        <!-- Top Toolbar: Sticky Filter Pills & Counter -->
        <div class="sticky top-16 z-30 -mx-2 px-2 py-3 bg-background/90 backdrop-blur-md border-b border-border/60 flex flex-wrap items-center justify-between gap-2">
          <!-- Category filter pills -->
          <div class="flex flex-wrap gap-1.5" id="pill-filters">
            <button
              data-pill="all"
              class="pill-btn active rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] text-white border border-transparent px-3.5 py-1 font-bold text-xs shadow-sm transition-all duration-150 hover:brightness-105"
            >
              All ({allPosts.length})
            </button>
            {categories.map((c) => {
              const catColor = getCatColor(c);
              return counts[c] > 0 && (
                <button
                  data-pill={c}
                  class={`pill-btn rounded-full border ${catColor.border} ${catColor.bg} px-3 py-1 font-semibold text-xs ${catColor.text} hover:opacity-90 transition-all duration-150 shadow-2xs`}
                >
                  {categoryLabel[c]} ({counts[c]})
                </button>
              );
            })}
          </div>

          <!-- Newest Articles count indicator -->
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-white shadow-2xs">
              NEWEST ARTICLES
            </span>
            <span id="articles-count" class="font-mono text-xs text-muted-foreground">
              {allPosts.length} articles
            </span>
          </div>
        </div>

        <!-- ── LATEST POSTS SECTION (ABOVE FIRST BLOG CARD) ──────────── -->
        <div class="rounded-2xl border border-border/80 bg-card p-5 sm:p-6 shadow-xs transition-all duration-200">
          <div class="flex items-center justify-between border-b border-border/60 pb-3 mb-4">
            <div class="flex items-center gap-2.5">
              <span class="rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-3.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-white shadow-2xs">
                NEWEST ARTICLES
              </span>
              <span class="font-mono text-xs text-muted-foreground">
                {allPosts.length} articles
              </span>
            </div>
            <span class="font-mono text-xs text-muted-foreground">
              Recent updates
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            {latestPosts.slice(0, 4).map((post) => {
              const slug = post.id.replace(/\.md$/, "");
              return (
                <a
                  href={`/blog/${slug}/`}
                  class="group flex flex-col justify-between rounded-xl border border-border/70 bg-surface/80 hover:bg-card p-3 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-xs"
                >
                  <h3 class="text-xs sm:text-sm font-bold leading-snug line-clamp-2 text-foreground group-hover:text-primary transition-colors">
                    {post.data.title}
                  </h3>
                  <div class="mt-2.5 flex items-center justify-between font-mono text-[11px] text-muted-foreground">
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                    </time>
                    <span class="text-primary font-bold opacity-0 group-hover:opacity-100 transition-opacity">Read →</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- ── 1. FIRST BLOG CARD (FEATURED) ────────────────────────── -->
        {featured && (() => {
          const catColor = getCatColor(featured.data.category);
          return (
            <article
              data-post-cat={featured.data.category}
              data-title={featured.data.title.toLowerCase()}
              data-desc={featured.data.description.toLowerCase()}
              data-tags={featured.data.tags.join(" ").toLowerCase()}
              class="post-item blog-card group rounded-2xl border border-border/80 bg-card p-7 shadow-xs transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5 hover:border-primary/40"
            >
              <!-- Top Badges & Read Time Row -->
              <div class="flex items-center gap-2.5 mb-3.5">
                <span class={`rounded-full border ${catColor.border} ${catColor.bg} px-3 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider ${catColor.text}`}>
                  {categoryLabel[featured.data.category] ?? featured.data.category}
                </span>
                <span class="rounded-full border border-border bg-muted px-3 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider text-foreground">
                  FEATURED
                </span>
                <span class="font-mono text-xs text-muted-foreground ml-1">
                  {Math.ceil((featured.data.wordCount || 3600) / 200)} min read
                </span>
              </div>

              <!-- Large Gradient Heading -->
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight leading-snug transition-all duration-150">
                <a href={`/blog/${featured.id.replace(/\.md$/, "")}/`} class="text-gradient hover:opacity-90">
                  {featured.data.title}
                </a>
              </h2>

              <!-- Excerpt -->
              <p class="mt-3 text-base text-muted-foreground leading-relaxed max-w-4xl">
                {featured.data.description}
              </p>

              <!-- Tags Pills -->
              <div class="mt-4 flex flex-wrap gap-2 text-xs font-mono">
                {featured.data.tags.map((t: string) => (
                  <a
                    href={`/tags/${encodeURIComponent(t.toLowerCase().trim())}/`}
                    class={`rounded-md border ${catColor.border} ${catColor.pillBg} px-2.5 py-0.5 text-xs text-foreground/80 transition-colors`}
                  >
                    #{t}
                  </a>
                ))}
              </div>

              <!-- Date & Author Metadata -->
              <div class="mt-4 font-mono text-xs text-muted-foreground">
                <time datetime={featured.data.publishedAt.toISOString()}>
                  {featured.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                </time>
                <span> · </span>
                <span>QuickZTNA Engineering</span>
              </div>
            </article>
          );
        })()}

        <!-- ── 2. REST OF BLOG CARDS (2-COLUMN GRID) ────────────────── -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="articles-container">
          {restPosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const readTime = post.data.wordCount ? Math.ceil(post.data.wordCount / 200) : 12;
            const catColor = getCatColor(post.data.category);

            return (
              <article
                data-post-cat={post.data.category}
                data-title={post.data.title.toLowerCase()}
                data-desc={post.data.description.toLowerCase()}
                data-tags={post.data.tags.join(" ").toLowerCase()}
                class="post-item blog-card group flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-xs transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl hover:shadow-primary/5 hover:border-primary/40"
              >
                <div>
                  <!-- Top Row: Category Badge (Left) & Read Time (Right) -->
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <span class={`rounded-full border ${catColor.border} ${catColor.bg} px-3 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider ${catColor.text}`}>
                      {categoryLabel[post.data.category] ?? post.data.category}
                    </span>
                    <span class="font-mono text-xs text-muted-foreground">
                      {readTime} min
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="text-xl font-bold tracking-tight leading-snug line-clamp-2">
                    <a href={`/blog/${slug}/`} class="text-gradient hover:opacity-90 transition-opacity">
                      {post.data.title}
                    </a>
                  </h3>

                  <!-- Description / Excerpt -->
                  <p class="mt-3 text-sm text-muted-foreground leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                </div>

                <div class="mt-5">
                  <!-- Tags List with Category Color -->
                  <div class="flex flex-wrap gap-2 text-xs font-mono">
                    {post.data.tags.slice(0, 4).map((t: string) => (
                      <a
                        href={`/tags/${encodeURIComponent(t.toLowerCase().trim())}/`}
                        class={`rounded-md border ${catColor.border} ${catColor.pillBg} px-2.5 py-0.5 text-xs text-foreground/80 transition-colors`}
                      >
                        #{t}
                      </a>
                    ))}
                  </div>

                  <!-- Date -->
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    class="mt-3 block font-mono text-xs text-muted-foreground"
                  >
                    {post.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </time>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty state -->
        <div id="no-posts" class="hidden rounded-2xl border border-border bg-card p-10 text-center">
          <p class="text-sm font-bold text-foreground">No matching articles found</p>
          <p class="mt-1 text-xs text-muted-foreground">Try selecting a different topic filter.</p>
        </div>
      </main>

    </div>
  </div>
</SiteLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-card {
    animation: fadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  function setupBlogFiltering() {
    const countEl = document.getElementById("articles-count");
    const noPostsEl = document.getElementById("no-posts");

    const topicButtons = document.querySelectorAll<HTMLButtonElement>("[data-topic]");
    const pillButtons = document.querySelectorAll<HTMLButtonElement>("[data-pill]");
    const postItems = document.querySelectorAll<HTMLElement>(".post-item");

    let currentFilterType = "all"; // "all" | "category" | "tag"
    let currentFilterVal = "all";

    function filterPosts() {
      let visibleCount = 0;

      postItems.forEach((item) => {
        const postCat = item.dataset.postCat || "";
        const tags = item.dataset.tags || "";

        let matchesFilter = true;
        if (currentFilterType === "category") {
          matchesFilter = currentFilterVal === "all" || postCat === currentFilterVal;
        } else if (currentFilterType === "tag") {
          matchesFilter = currentFilterVal === "all" || tags.includes(currentFilterVal);
        }

        if (matchesFilter) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      if (countEl) {
        countEl.textContent = `${visibleCount} ${visibleCount === 1 ? "article" : "articles"}`;
      }

      if (noPostsEl) {
        noPostsEl.classList.toggle("hidden", visibleCount > 0);
      }
    }

    function setFilter(type: "all" | "category" | "tag", val: string) {
      currentFilterType = type;
      currentFilterVal = val;

      // Update Left Sidebar Topic Buttons
      topicButtons.forEach((btn) => {
        const cat = btn.dataset.topic;
        const isActive = (type === "category" && cat === val) || (type === "all" && cat === "all");
        if (isActive) {
          btn.className = "topic-btn active flex w-full items-center justify-between rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-4 py-2 text-xs font-bold text-white shadow-sm transition-all duration-150 text-left";
        } else {
          btn.className = "topic-btn flex w-full items-center justify-between rounded-full px-4 py-2 text-xs font-semibold text-foreground/80 hover:bg-primary/5 hover:text-primary transition-all duration-150 text-left group";
        }
      });

      // Update Middle Pill Buttons
      pillButtons.forEach((btn) => {
        const pillCat = btn.dataset.pill;
        const isActive = (type === "category" && pillCat === val) || (type === "all" && pillCat === "all");
        if (isActive) {
          btn.className = "pill-btn active rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] text-white border border-transparent px-3.5 py-1 font-bold text-xs shadow-sm transition-all duration-150 hover:brightness-105";
        } else {
          btn.className = "pill-btn rounded-full border border-border bg-card px-3 py-1 font-semibold text-xs text-foreground/80 hover:border-primary/40 hover:bg-primary/5 hover:text-primary transition-all duration-150";
        }
      });

      filterPosts();
    }

    topicButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.topic ?? "all";
        if (cat === "all") {
          setFilter("all", "all");
        } else {
          setFilter("category", cat);
        }
      });
    });

    pillButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.pill ?? "all";
        if (cat === "all") {
          setFilter("all", "all");
        } else {
          setFilter("category", cat);
        }
      });
    });

    // Check query param
    const params = new URLSearchParams(window.location.search);
    const initialCat = params.get("category");
    const initialTag = params.get("tag");
    if (initialTag) {
      setFilter("tag", initialTag);
    } else if (initialCat) {
      setFilter("category", initialCat);
    } else {
      setFilter("all", "all");
    }
  }

  setupBlogFiltering();
  document.addEventListener("astro:after-swap", setupBlogFiltering);
</script>
