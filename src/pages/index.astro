---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const categoryLabel: Record<string, string> = {
  "post-quantum": "Architecture",
  comparison: "Comparison",
  compliance: "Compliance",
  technical: "Technical",
  fundamentals: "Fundamentals",
  industry: "Industry",
};

const categoryBadgeColors: Record<string, { bg: string; text: string; border: string; pillBg: string }> = {
  "post-quantum": {
    bg: "bg-blue-50",
    text: "text-blue-700",
    border: "border-blue-200",
    pillBg: "bg-blue-50/60 hover:bg-blue-100/70 hover:border-blue-300 hover:text-blue-800",
  },
  comparison: {
    bg: "bg-purple-50",
    text: "text-purple-700",
    border: "border-purple-200",
    pillBg: "bg-purple-50/60 hover:bg-purple-100/70 hover:border-purple-300 hover:text-purple-800",
  },
  compliance: {
    bg: "bg-emerald-50",
    text: "text-emerald-700",
    border: "border-emerald-200",
    pillBg: "bg-emerald-50/60 hover:bg-emerald-100/70 hover:border-emerald-300 hover:text-emerald-800",
  },
  technical: {
    bg: "bg-cyan-50",
    text: "text-cyan-700",
    border: "border-cyan-200",
    pillBg: "bg-cyan-50/60 hover:bg-cyan-100/70 hover:border-cyan-300 hover:text-cyan-800",
  },
  fundamentals: {
    bg: "bg-amber-50",
    text: "text-amber-700",
    border: "border-amber-200",
    pillBg: "bg-amber-50/60 hover:bg-amber-100/70 hover:border-amber-300 hover:text-amber-800",
  },
  industry: {
    bg: "bg-rose-50",
    text: "text-rose-700",
    border: "border-rose-200",
    pillBg: "bg-rose-50/60 hover:bg-rose-100/70 hover:border-rose-300 hover:text-rose-800",
  },
};

const getCatColor = (cat: string) =>
  categoryBadgeColors[cat] ?? {
    bg: "bg-primary/10",
    text: "text-primary",
    border: "border-primary/20",
    pillBg: "bg-muted/60 hover:bg-primary/5 hover:border-primary/40 hover:text-primary",
  };

const categories = ["post-quantum", "comparison", "compliance", "technical", "fundamentals", "industry"] as const;

// Category post counts
const counts = Object.fromEntries(
  categories.map((c) => [c, allPosts.filter((p) => p.data.category === c).length])
);

// Featured post (latest/first) and remaining posts
const featured = allPosts[0];
const restPosts = allPosts.slice(1);

// Recent updates for the right sidebar (top 6 newest)
const recentUpdates = allPosts.slice(0, 7);

// Curated highlights for the left sidebar (7 core articles)
const founderSpecials = [
  allPosts.find((p) => p.id.includes("ztna-vs-vpn")) || allPosts[0],
  allPosts.find((p) => p.id.includes("wireguard-mesh-network")) || allPosts[1],
  allPosts.find((p) => p.id.includes("outbound-only-zero-trust")) || allPosts[2],
  allPosts.find((p) => p.id.includes("identity-first-networking")) || allPosts[3],
  allPosts.find((p) => p.id.includes("device-posture-checks")) || allPosts[4],
  allPosts.find((p) => p.id.includes("kubernetes-zero-trust")) || allPosts[5],
  allPosts.find((p) => p.id.includes("sase-vs-ztna-vs-sse")) || allPosts[6],
];

const blogIndexSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.quickztna.com/blog/",
  url: "https://www.quickztna.com/blog/",
  name: "QuickZTNA Blog",
  description: "Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team.",
  publisher: { "@id": "https://www.quickztna.com/#organization" },
  inLanguage: "en",
  blogPost: allPosts.slice(0, 20).map((p) => {
    const slug = p.id.replace(/\.md$/, "");
    return {
      "@type": "BlogPosting",
      headline: p.data.title,
      description: p.data.description,
      url: `https://www.quickztna.com/blog/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      dateModified: (p.data.updatedAt ?? p.data.publishedAt).toISOString(),
      author: { "@type": "Person", name: p.data.author.name },
    };
  }),
};

const blogBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.quickztna.com" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://www.quickztna.com/blog/" },
  ],
};
---

<SiteLayout
  title="QuickZTNA Blog — Zero Trust, WireGuard Mesh & Cloud Security"
  description="Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team on Zero Trust Network Access, WireGuard mesh, and cloud security."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogIndexSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(blogBreadcrumbSchema)} is:inline />
  </Fragment>

  <!-- Main 3-Column Page Layout Container -->
  <div class="mx-auto max-w-[1750px] px-3 sm:px-5 lg:px-6 py-6 sm:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_1fr] xl:grid-cols-[16.5rem_1fr_17rem] gap-6 items-start">

      <!-- ── LEFT SIDEBAR (STICKY ON SCROLL) ───────────────────────── -->
      <aside class="w-full lg:w-[16rem] xl:w-[16.5rem] space-y-5 order-2 lg:order-1 lg:sticky lg:top-20 self-start">
        


        <!-- 3. Engineering Essentials (Founder Special Card - Completely Borderless) -->
        <div class="p-1 sm:p-2">
          <div class="flex items-center justify-between pb-1 mb-2">
            <span class="rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider">
              FOUNDER SPECIAL
            </span>
            <span class="font-mono text-xs text-muted-foreground">
              {founderSpecials.length} articles
            </span>
          </div>

          <p class="mb-2.5 font-mono text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
            Core Architectures
          </p>

          <div class="space-y-2">
            {founderSpecials.map((post) => {
              const slug = post.id.replace(/\.md$/, "");
              return (
                <div class="py-1">
                  <a href={`/blog/${slug}/`} class="group block">
                    <h4 class="text-xs font-bold leading-[1.35] line-clamp-2 text-foreground group-hover:text-primary transition-colors">
                      {post.data.title}
                    </h4>
                    <div class="mt-1 flex items-center justify-between font-sans text-[11px] text-muted-foreground">
                      <span>{post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
                      <span class="font-semibold text-primary group-hover:underline">Read →</span>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
          <a href="#posts-grid" class="mt-3 inline-block font-mono text-xs font-bold text-primary hover:underline">
            View All Specials →
          </a>
        </div>
      </aside>

      <!-- ── CENTER SCROLLING BLOG FEED (NETWORKERSHOME TOPOLOGY) ───── -->
      <main class="min-w-0 space-y-6 order-1 lg:order-2">
        
        <!-- Center Title Header (Clean inline header without large hero) -->
        <div class="border-b border-border/60 pb-4">
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
            Quick<span class="text-gradient">ZTNA</span> <span class="text-gradient">Blog</span>
          </h1>
          <p class="mt-1.5 text-xs sm:text-sm text-muted-foreground">
            Guides, architectural teardowns, benchmarks, and product updates from the QuickZTNA team.
          </p>
          
          <div class="mt-3.5 flex items-center gap-2">
            <span class="rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-3.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-white shadow-2xs">
              🔥 NEWEST ARTICLES
            </span>
            <span class="text-xs text-muted-foreground font-medium">
              Latest from our experts
            </span>
          </div>
        </div>

        <!-- ── FEATURED TOP HERO CARD (HORIZONTAL 2-COL NETWORKERSHOME STYLE) ── -->
        {featured && (() => {
          const fSlug = featured.id.replace(/\.md$/, "");
          const fColor = getCatColor(featured.data.category);
          return (
            <article class="group rounded-2xl border border-border/80 bg-card overflow-hidden shadow-xs hover:shadow-md hover:border-primary/50 transition-all duration-300">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch">
                <!-- Left Visual Graphic Box -->
                <div class="md:col-span-5 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 flex flex-col justify-between relative overflow-hidden min-h-[220px]">
                  <div class="absolute inset-0 bg-grid opacity-30 pointer-events-none" aria-hidden="true"></div>
                  
                  <!-- Top Status Pill -->
                  <div class="relative z-10 flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-300">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      ACTIVE MESH
                    </span>
                    <span class="font-mono text-[10px] text-slate-400">P2P v2.4</span>
                  </div>

                  <!-- Center Graphic Icon / Topology Display -->
                  <div class="relative z-10 my-4 flex items-center justify-center">
                    <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-primary to-[#00a3c4] p-0.5 shadow-lg group-hover:scale-105 transition-transform duration-300">
                      <div class="h-full w-full rounded-[14px] bg-slate-900/90 flex items-center justify-center">
                        <svg class="h-8 w-8 text-[#00a3c4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="2" y="2" width="20" height="8" rx="2" stroke-linecap="round"/>
                          <rect x="2" y="14" width="20" height="8" rx="2" stroke-linecap="round"/>
                          <path d="M6 6h.01M6 18h.01" stroke-linecap="round"/>
                          <path d="M12 10v4" stroke-linecap="round" stroke-dasharray="2 2"/>
                        </svg>
                      </div>
                    </div>
                  </div>

                  <!-- Bottom Tagline -->
                  <div class="relative z-10 flex items-center justify-between text-[11px] font-mono text-slate-300">
                    <span>WireGuard ABAC</span>
                    <span class="text-primary font-bold">100% Zero-Trust</span>
                  </div>
                </div>

                <!-- Right Content Box -->
                <div class="md:col-span-7 p-5 sm:p-6 flex flex-col justify-between bg-card">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                      <span class={`rounded-md border ${fColor.border} ${fColor.bg} px-2.5 py-0.5 font-semibold text-xs ${fColor.text}`}>
                        {categoryLabel[featured.data.category]}
                      </span>
                      <span class="rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase">
                        ⚡ NEW
                      </span>
                    </div>

                    <a href={`/blog/${fSlug}/`} class="block group">
                      <h2 class="text-lg sm:text-xl font-bold leading-snug text-foreground group-hover:text-primary transition-colors">
                        {featured.data.title}
                      </h2>
                    </a>

                    <p class="mt-2 text-xs sm:text-sm text-muted-foreground line-clamp-3 leading-relaxed">
                      {featured.data.description}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground">
                    <span>{featured.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                    <a href={`/blog/${fSlug}/`} class="font-bold text-primary group-hover:underline inline-flex items-center gap-1">
                      Read article <span>→</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })()}

        <!-- ── STICKY FULL-WIDTH CATEGORY FILTER TOOLBAR ─────────────── -->
        <div class="sticky top-16 z-30 -mx-2 px-2 py-3 bg-background/90 backdrop-blur-md border-b border-border/60">
          <div class="w-full flex flex-wrap sm:flex-nowrap items-center justify-between gap-2" id="pill-filters">
            <button
              data-pill="all"
              class="pill-btn active flex-1 text-center justify-center rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] text-white border border-transparent px-3 py-1.5 font-bold text-xs shadow-sm transition-all duration-150 hover:brightness-105 whitespace-nowrap"
            >
              All ({allPosts.length})
            </button>
            {categories.map((c) => {
              const catColor = getCatColor(c);
              return counts[c] > 0 && (
                <button
                  data-pill={c}
                  class={`pill-btn flex-1 text-center justify-center rounded-full border ${catColor.border} ${catColor.bg} px-3 py-1.5 font-semibold text-xs ${catColor.text} hover:opacity-90 transition-all duration-150 shadow-2xs whitespace-nowrap`}
                >
                  {categoryLabel[c]} ({counts[c]})
                </button>
              );
            })}
          </div>
        </div>

        <!-- ── MAIN POSTS GRID (2-3 COLUMN NETWORKERSHOME CARD TOPOLOGY) ─ -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" id="posts-grid">
          {restPosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const catColor = getCatColor(post.data.category);
            const tagsStr = (post.data.tags ?? []).join(" ");
            return (
              <article
                class="post-item group relative flex flex-col justify-between rounded-xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-md"
                data-post-cat={post.data.category}
                data-tags={tagsStr}
              >
                <div>
                  <!-- Category tag & Date -->
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class={`rounded-md border ${catColor.border} ${catColor.bg} px-2 py-0.5 font-semibold text-[11px] ${catColor.text}`}>
                      {categoryLabel[post.data.category]}
                    </span>
                    <span class="font-mono text-[10px] text-muted-foreground">
                      {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                    </span>
                  </div>

                  <!-- Title -->
                  <a href={`/blog/${slug}/`} class="block group">
                    <h3 class="text-sm sm:text-base font-bold leading-snug text-foreground group-hover:text-primary transition-colors line-clamp-2">
                      {post.data.title}
                    </h3>
                  </a>

                  <!-- Excerpt snippet -->
                  <p class="mt-2 text-xs text-muted-foreground line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>

                <!-- Footer with read link -->
                <div class="mt-4 pt-3 border-t border-border/50 flex items-center justify-between text-xs">
                  <span class="font-mono text-[11px] text-muted-foreground">
                    {post.data.wordCount ? `${Math.round(post.data.wordCount / 200)} min read` : "8 min read"}
                  </span>
                  <a href={`/blog/${slug}/`} class="font-bold text-primary group-hover:underline inline-flex items-center gap-1">
                    Read article <span>→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- No posts empty state -->
        <div id="no-posts" class="hidden rounded-xl border border-dashed border-border py-12 text-center">
          <p class="text-sm font-semibold text-muted-foreground">No articles found in this category.</p>
          <button
            id="reset-filter-btn"
            class="mt-3 rounded-md bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90"
          >
            Show all articles
          </button>
        </div>
      </main>

      <!-- ── RIGHT SIDEBAR (STICKY ON SCROLL - NEWEST ARTICLES LIST) ─ -->
      <aside class="w-full xl:w-[17rem] space-y-5 order-3 xl:sticky xl:top-20 self-start hidden xl:block">
        
        <!-- Newest Articles / AI Special Card - Completely Borderless -->
        <div class="p-1 sm:p-2">
          <div class="flex items-center justify-between pb-1 mb-2">
            <span class="rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-white shadow-2xs">
              NEWEST ARTICLES
            </span>
            <span class="font-mono text-xs text-muted-foreground">
              {allPosts.length} articles
            </span>
          </div>

          <p class="mb-2.5 font-mono text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
            Recent updates
          </p>

          <div class="space-y-2">
            {recentUpdates.map((p) => {
              const pSlug = p.id.replace(/\.md$/, "");
              return (
                <div class="py-1">
                  <a href={`/blog/${pSlug}/`} class="group block">
                    <h4 class="text-xs font-bold leading-[1.35] line-clamp-2 text-foreground group-hover:text-primary transition-colors">
                      {p.data.title}
                    </h4>
                    <div class="mt-1 flex items-center justify-between font-sans text-[11px] text-muted-foreground">
                      <span>{p.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
                      <span class="font-semibold text-primary group-hover:underline">Read →</span>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>

          <a href="#posts-grid" class="mt-3 inline-block font-mono text-xs font-bold text-primary hover:underline">
            View All Specials →
          </a>
        </div>

        <!-- Cloud Mesh Quick Install Card -->
        <div class="rounded-xl bg-primary/5 p-4 border-0">
          <div class="flex items-center gap-2 mb-2">
            <span class="h-2 w-2 rounded-full bg-success animate-pulse"></span>
            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-foreground">Global Mesh</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Connect servers, databases, and developers in &lt; 2 minutes.
          </p>
          <div class="mt-3 rounded-md bg-muted/80 p-2.5 font-mono text-[11px] text-foreground border border-border/60 select-all overflow-x-auto">
            curl -fsSL https://login.quickztna.com/install.sh | sh
          </div>
        </div>
      </aside>

    </div>
  </div>
</SiteLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-item {
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  function setupBlogFiltering() {
    const noPostsEl = document.getElementById("no-posts");
    const resetBtn = document.getElementById("reset-filter-btn");

    const topicButtons = document.querySelectorAll<HTMLButtonElement>("[data-topic]");
    const pillButtons = document.querySelectorAll<HTMLButtonElement>("[data-pill]");
    const postItems = document.querySelectorAll<HTMLElement>(".post-item");

    let currentFilterType = "all"; // "all" | "category" | "tag"
    let currentFilterVal = "all";

    function filterPosts() {
      let visibleCount = 0;

      postItems.forEach((item) => {
        const postCat = item.dataset.postCat || "";
        const tags = item.dataset.tags || "";

        let matchesFilter = true;
        if (currentFilterType === "category") {
          matchesFilter = currentFilterVal === "all" || postCat === currentFilterVal;
        } else if (currentFilterType === "tag") {
          matchesFilter = currentFilterVal === "all" || tags.includes(currentFilterVal);
        }

        if (matchesFilter) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      if (noPostsEl) {
        noPostsEl.classList.toggle("hidden", visibleCount > 0);
      }
    }

    function setFilter(type: "all" | "category" | "tag", val: string) {
      currentFilterType = type;
      currentFilterVal = val;

      // Update Left Sidebar Topic Buttons
      topicButtons.forEach((btn) => {
        const cat = btn.dataset.topic;
        const isActive = (type === "category" && cat === val) || (type === "all" && cat === "all");
        if (isActive) {
          btn.className = "topic-btn active flex w-full items-center justify-between rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-4 py-2 text-xs font-bold text-white shadow-sm transition-all duration-150 text-left";
        } else {
          btn.className = "topic-btn flex w-full items-center justify-between rounded-full px-4 py-2 text-xs font-semibold text-foreground/80 hover:bg-primary/5 hover:text-primary transition-all duration-150 text-left group";
        }
      });

      // Update Middle Pill Buttons
      pillButtons.forEach((btn) => {
        const pillCat = btn.dataset.pill;
        const isActive = (type === "category" && pillCat === val) || (type === "all" && pillCat === "all");
        if (isActive) {
          btn.className = "pill-btn active flex-1 text-center justify-center rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] text-white border border-transparent px-3 py-1.5 font-bold text-xs shadow-sm transition-all duration-150 hover:brightness-105 whitespace-nowrap";
        } else {
          btn.className = "pill-btn flex-1 text-center justify-center rounded-full border border-border bg-card px-3 py-1.5 font-semibold text-xs text-foreground/80 hover:border-primary/40 hover:bg-primary/5 hover:text-primary transition-all duration-150 shadow-2xs whitespace-nowrap";
        }
      });

      filterPosts();
    }

    topicButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.topic ?? "all";
        if (cat === "all") {
          setFilter("all", "all");
        } else {
          setFilter("category", cat);
        }
      });
    });

    pillButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.pill ?? "all";
        if (cat === "all") {
          setFilter("all", "all");
        } else {
          setFilter("category", cat);
        }
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        setFilter("all", "all");
      });
    }

    // Check query param
    const params = new URLSearchParams(window.location.search);
    const initialCat = params.get("category");
    const initialTag = params.get("tag");
    if (initialTag) {
      setFilter("tag", initialTag);
    } else if (initialCat) {
      setFilter("category", initialCat);
    }
  }

  setupBlogFiltering();
  document.addEventListener("astro:after-swap", setupBlogFiltering);
</script>
