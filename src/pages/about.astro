---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const recentPosts = allPosts.slice(0, 3);

const categories = [
  {
    id: "post-quantum",
    name: "Architecture",
    tagline: "Understand how Zero Trust and quantum-resistant systems are engineered.",
    badgeColor: "border-blue-200 bg-blue-50 text-blue-700",
    topics: ["Noise IK Handshakes", "NIST SP 800-207", "Full-Mesh Overlay", "Microsegmentation"],
  },
  {
    id: "technical",
    name: "Technical",
    tagline: "Implementation details, Linux kernel modules, eBPF telemetry, and protocol benchmarks.",
    badgeColor: "border-cyan-200 bg-cyan-50 text-cyan-700",
    topics: ["eBPF Flow Probes", "Kernel vs Userspace", "NAT Traversal (STUN/DERP)", "MASQUE HTTP/3"],
  },
  {
    id: "compliance",
    name: "Compliance",
    tagline: "Translate complex security mandates into verifiable architectural controls.",
    badgeColor: "border-emerald-200 bg-emerald-50 text-emerald-700",
    topics: ["SOC 2 Criteria", "HIPAA Security Rule", "EU NIS2 & DORA", "PCI DSS 4.0 Scope"],
  },
  {
    id: "comparison",
    name: "Comparisons",
    tagline: "Unvarnished architectural breakdowns, total cost of ownership models, and trade-offs.",
    badgeColor: "border-purple-200 bg-purple-50 text-purple-700",
    topics: ["ZTNA vs Legacy VPN", "Tailscale vs Self-Hosted", "Cloudflare Access", "Cisco AnyConnect"],
  },
  {
    id: "fundamentals",
    name: "Fundamentals",
    tagline: "Build a strong, first-principles foundation in zero-trust network access.",
    badgeColor: "border-amber-200 bg-amber-50 text-amber-700",
    topics: ["What is ZTNA?", "Single Packet Auth", "ABAC vs RBAC", "Continuous Posture"],
  },
  {
    id: "industry",
    name: "Industry",
    tagline: "Real-world zero trust implementations across healthcare, financial, and industrial networks.",
    badgeColor: "border-rose-200 bg-rose-50 text-rose-700",
    topics: ["DevSecOps Ephemeral CI/CD", "Industrial OT / IoT", "Contractor Access", "Database Bastions"],
  },
];

const editorialPrinciples = [
  {
    num: "01",
    title: "Accuracy over hype",
    desc: "We verify every cryptographic primitive and throughput metric against RFC specifications and benchmark testbeds before publication.",
  },
  {
    num: "02",
    title: "Practical engineering over buzzwords",
    desc: "We provide functional configuration files, ASCII packet topologies, and copy-pasteable commands rather than high-level sales fluff.",
  },
  {
    num: "03",
    title: "Evidence over unsupported claims",
    desc: "Technical claims cite official NIST standards (FIPS 203/204/205), IETF drafts, CVE advisories, and reproducible kernel benchmarks.",
  },
  {
    num: "04",
    title: "Clear trade-offs over one-sided comparisons",
    desc: "Every comparison fairly details memory overhead, control plane latency, operational maintenance, and real-world failure modes.",
  },
  {
    num: "05",
    title: "Current information over outdated assumptions",
    desc: "Security evolves constantly. When cryptographic guidelines (e.g. ANSSI, BSI, CNSA 2.0) or software versions change, our articles are updated.",
  },
  {
    num: "06",
    title: "Security transparency over marketing language",
    desc: "We openly discuss what post-quantum KEMs can and cannot protect against today (e.g. Harvest Now, Decrypt Later defenses vs signature maturity).",
  },
];

const researchSteps = [
  {
    step: "01",
    name: "Threat Model & Problem",
    desc: "Identify a concrete network vulnerability, migration blocker, or compliance gap faced by engineering teams.",
  },
  {
    step: "02",
    name: "Primary Standards Research",
    desc: "Analyze source RFCs (RFC 8489, RFC 9298), NIST Special Publications (SP 800-207), and regulatory frameworks.",
  },
  {
    step: "03",
    name: "Lab Testbed Benchmarking",
    desc: "Reproduce network behavior on Linux kernel testbeds to measure latency, CPU saturation, and packet loss.",
  },
  {
    step: "04",
    name: "Peer Engineering Review",
    desc: "Cross-review draft configurations, CLI parameters, and cryptographic math with domain engineers.",
  },
  {
    step: "05",
    name: "Publication & Schema Audit",
    desc: "Release with full JSON-LD schema (FAQ, Article, Breadcrumb) and high-density contextual backlinks.",
  },
  {
    step: "06",
    name: "Continuous Maintenance",
    desc: "Regularly audit and update code snippets, algorithm timelines, and regulatory deadlines.",
  },
];

const targetAudiences = [
  {
    title: "Security & Risk Teams",
    roles: "CISOs, SecOps Engineers & Compliance Leads",
    benefit: "Actionable audit control mappings (SOC 2, HIPAA, DORA, NIS2) and post-quantum migration roadmaps.",
    color: "from-blue-500/10 to-cyan-500/10 border-blue-200",
  },
  {
    title: "Network & Systems Architects",
    roles: "Infrastructure Engineers & Network Operations",
    benefit: "WireGuard kernel tuning, NAT traversal mechanics, eBPF telemetry, and multi-cloud mesh topologies.",
    color: "from-purple-500/10 to-indigo-500/10 border-purple-200",
  },
  {
    title: "Platform & DevOps Builders",
    roles: "SREs, Cloud Architects & DevSecOps Teams",
    benefit: "Securing ephemeral CI/CD runners, Just-in-Time database access, Kubernetes mesh, and Terraform automation.",
    color: "from-emerald-500/10 to-teal-500/10 border-emerald-200",
  },
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About QuickZTNA Blog — Editorial Standards & Technical Mission",
  description: "Learn why the QuickZTNA blog exists, our editorial principles, our research methodology, and the engineering team behind the publication.",
  url: "https://blog.quickztna.com/about/",
  publisher: {
    "@type": "Organization",
    name: "QuickZTNA",
    url: "https://blog.quickztna.com",
    logo: "https://blog.quickztna.com/favicon.svg"
  }
};
---

<SiteLayout
  title="About QuickZTNA Blog — Editorial Standards & Engineering Mission"
  description="Learn why QuickZTNA publishes in-depth Zero Trust research, our rigorous research methodology, our editorial principles, and the team behind the content."
  canonical="https://blog.quickztna.com/about/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} is:inline />
  </Fragment>

  <!-- ── ABOUT PAGE HERO (COMPACT MISSION & REMOTE ACCESS) ──────── -->
  <section class="border-b border-border/70 bg-hero relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-85 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1700px] px-4 py-8 sm:py-10">
      <div class="max-w-3xl space-y-2.5">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center rounded-full border border-blue-200 bg-white/90 px-3 py-0.5 shadow-2xs">
          <span class="text-xs font-semibold text-[#0066ff]">Our Mission</span>
        </div>

        <!-- Main H1 Heading -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-[#0f172a] leading-[1.15]">
          Fast, Simple, and Secure <span class="bg-gradient-to-r from-[#0066ff] to-[#00a3c4] bg-clip-text text-transparent">Remote Access</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="text-xs sm:text-sm lg:text-base text-[#475467] leading-relaxed max-w-2xl">
          QuickZTNA replaces legacy VPNs and complex corporate network infrastructure with lightning-fast WireGuard mesh tunnels and fine-grained Zero Trust policies.
        </p>
      </div>
    </div>
  </section>

  <!-- ── COMPACT CONTENT CONTAINER (TIGHTENED WHITESPACE) ─────────── -->
  <div class="mx-auto max-w-[1700px] px-4 py-8 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">

    <!-- ── SECTION 1: WHY THIS BLOG EXISTS ─────────────────────────── -->
    <section class="rounded-2xl border border-border/80 bg-card p-6 sm:p-8 shadow-xs relative overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-30 pointer-events-none" aria-hidden="true"></div>
      <div class="relative grid gap-6 lg:grid-cols-12 items-start">
        
        <div class="lg:col-span-4 space-y-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 border border-primary/20 px-3 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider text-primary">
            🛡️ Our Mission
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground leading-tight">
            Why the QuickZTNA Blog Exists
          </h2>
          <p class="font-mono text-xs text-muted-foreground">
            Cut through vendor marketing. Deliver verifiable engineering.
          </p>
        </div>

        <div class="lg:col-span-8 space-y-3.5 text-sm sm:text-base leading-relaxed text-[#334155]">
          <p class="font-semibold text-foreground text-base sm:text-lg">
            Security content should help engineers, architects, and CISOs make sound technical decisions—not just echo vendor buzzwords.
          </p>
          <p>
            When teams migrate from legacy hardware VPN concentrators to Zero Trust architectures, they face genuine questions: <em>How does WireGuard perform under high concurrency? How do we implement ML-KEM post-quantum key encapsulation without breaking handshakes? How do we satisfy EU DORA or HIPAA audit requirements without adding latency?</em>
          </p>
          <p>
            We created this publication to document our engineering research, cryptographic testbed benchmarks, protocol teardowns, and compliance blueprints. Every article is written with depth, backed by primary RFCs, and designed to provide practical value to technical practitioners.
          </p>
        </div>

      </div>
    </section>

    <!-- ── SECTION 2: WHAT WE WRITE ABOUT (6 CATEGORIES) ───────────── -->
    <section class="space-y-4">
      <div class="max-w-3xl space-y-1">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          📚 Content Taxonomy
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          What We Write About
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Our articles span six core domains covering the full spectrum of modern workforce security.
        </p>
      </div>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
        {categories.map((cat) => (
          <div class="flex flex-col justify-between rounded-xl border border-border/80 bg-card p-5 shadow-2xs hover:border-primary/40 hover:shadow-xs transition-all">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider ${cat.badgeColor}`}>
                  {cat.name}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[#334155] mb-3 leading-relaxed font-medium">
                {cat.tagline}
              </p>
              
              <ul class="space-y-1 border-t border-border/50 pt-2.5 text-[11px] font-mono text-muted-foreground">
                {cat.topics.map((t) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-primary font-bold">•</span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-4 pt-3 border-t border-border/60">
              <a
                href={`/blog/?category=${cat.id}`}
                class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1"
              >
                Browse {cat.name} Articles →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SECTION 3: EDITORIAL PRINCIPLES ─────────────────────────── -->
    <section class="rounded-2xl border border-border/80 bg-muted/20 p-6 sm:p-8 space-y-5">
      <div class="max-w-3xl space-y-1">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          ⚖️ Editorial Integrity
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Our 6 Editorial Principles
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground">
          The non-negotiable quality guidelines behind every article published on QuickZTNA.
        </p>
      </div>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
        {editorialPrinciples.map((ep) => (
          <div class="rounded-xl border border-border/80 bg-card p-4.5 shadow-2xs hover:border-primary/40 transition-all">
            <span class="font-mono text-xl font-black text-gradient block mb-1.5">
              {ep.num}
            </span>
            <h3 class="text-sm font-bold text-foreground mb-1">
              {ep.title}
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              {ep.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SECTION 4: HOW WE RESEARCH (VISUAL PIPELINE) ────────────── -->
    <section class="space-y-5">
      <div class="max-w-3xl space-y-1">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          🔬 Research Methodology
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          How We Research & Validate Technical Claims
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Every guide goes through a multi-stage validation pipeline to ensure code reproducibility and cryptographic accuracy.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        {researchSteps.map((rs) => (
          <div class="flex flex-col justify-between rounded-xl border border-border/80 bg-card p-4 shadow-2xs hover:border-primary/40 transition-all">
            <div>
              <span class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-primary/10 font-mono text-[11px] font-bold text-primary mb-2.5">
                {rs.step}
              </span>
              <h4 class="text-xs font-bold text-foreground mb-1">
                {rs.name}
              </h4>
              <p class="text-[11px] text-muted-foreground leading-relaxed">
                {rs.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="rounded-xl border border-primary/20 bg-primary/5 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-muted-foreground">
        <p>
          <strong class="text-foreground">Standards Citations:</strong> We link directly to official NIST FIPS 203/204/205 specifications, IETF RFCs (RFC 9298, RFC 8489), and regulatory frameworks in all publications.
        </p>
        <a href="/tags/" class="shrink-0 font-bold text-primary hover:underline">
          Explore Research by Tag →
        </a>
      </div>
    </section>

    <!-- ── SECTION 5: WHO IS THIS BLOG FOR? ────────────────────────── -->
    <section class="space-y-4">
      <div class="max-w-3xl space-y-1">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          👥 Target Audience
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Who This Blog Is For
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Designed specifically for technical practitioners building and securing modern distributed networks.
        </p>
      </div>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-3">
        {targetAudiences.map((aud) => (
          <div class={`rounded-xl border bg-gradient-to-b ${aud.color} p-5 shadow-2xs space-y-2.5`}>
            <h3 class="text-lg font-bold text-foreground">
              {aud.title}
            </h3>
            <p class="font-mono text-xs font-semibold text-primary">
              {aud.roles}
            </p>
            <p class="text-xs text-[#334155] leading-relaxed">
              {aud.benefit}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SECTION 6: QUICKZTNA + THE BLOG ─────────────────────────── -->
    <section class="rounded-2xl border border-border/80 bg-card p-6 sm:p-8 shadow-xs space-y-5">
      <div class="grid gap-6 lg:grid-cols-12 items-center">
        <div class="lg:col-span-7 space-y-2.5">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
            ⚡ Platform Connection
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
            The Technology Behind The Blog
          </h2>
          <p class="text-xs sm:text-sm text-[#334155] leading-relaxed">
            QuickZTNA is an enterprise Zero Trust Network Access platform engineered on the open-standard WireGuard protocol. We combine encrypted peer-to-peer overlay networking, kernel-level ABAC policy enforcement, continuous device posture verification, and post-quantum ML-KEM key encapsulation.
          </p>
          <p class="text-xs text-muted-foreground">
            Our educational content reflects the actual protocols, cryptographic primitives, and distributed systems we engineer daily.
          </p>
        </div>

        <div class="lg:col-span-5 flex flex-col gap-2.5 justify-center">
          <a
            href="https://quickztna.com/features"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-border/80 bg-muted/30 p-3.5 hover:border-primary/50 hover:bg-muted/60 transition-all group"
          >
            <div>
              <span class="font-bold text-xs sm:text-sm text-foreground group-hover:text-primary">Platform Features</span>
              <p class="text-[11px] text-muted-foreground">Mesh, ABAC, Posture & DNS filtering</p>
            </div>
            <span class="font-bold text-primary text-sm">↗</span>
          </a>

          <a
            href="https://quickztna.com/docs/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-border/80 bg-muted/30 p-3.5 hover:border-primary/50 hover:bg-muted/60 transition-all group"
          >
            <div>
              <span class="font-bold text-xs sm:text-sm text-foreground group-hover:text-primary">Developer Documentation</span>
              <p class="text-[11px] text-muted-foreground">API reference, SDKs, and CLI guides</p>
            </div>
            <span class="font-bold text-primary text-sm">↗</span>
          </a>

          <a
            href="https://quickztna.com/guide/quickstart/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-border/80 bg-muted/30 p-3.5 hover:border-primary/50 hover:bg-muted/60 transition-all group"
          >
            <div>
              <span class="font-bold text-xs sm:text-sm text-foreground group-hover:text-primary">Quickstart Deployment</span>
              <p class="text-[11px] text-muted-foreground">Deploy your first mesh tunnel in 2 minutes</p>
            </div>
            <span class="font-bold text-primary text-sm">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ── SECTION 7: EDITORIAL TEAMS & CONTRIBUTORS ───────────────── -->
    <section class="space-y-4">
      <div class="max-w-3xl space-y-1">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          👥 Engineering Authors
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Meet the Editorial & Engineering Teams
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Our articles are authored and peer-reviewed by practicing engineers across four core specializations.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            team: "Cryptography Research Team",
            focus: "Post-Quantum Algorithms, ML-KEM, Noise Protocol, and Key Rotation",
            icon: "🔐",
          },
          {
            team: "Zero Trust Architecture Team",
            focus: "NIST SP 800-207, Microsegmentation, ABAC Policies, and SDP",
            icon: "📐",
          },
          {
            team: "Compliance & Audit Engineering",
            focus: "SOC 2 Type II, HIPAA, EU NIS2, DORA, and ISO 27001 Mapping",
            icon: "📋",
          },
          {
            team: "DevSecOps & Systems Engineering",
            focus: "CI/CD Ephemeral Runners, Linux Kernel WireGuard, eBPF, and Cloud Mesh",
            icon: "⚙️",
          },
        ].map((tm) => (
          <div class="rounded-xl border border-border/80 bg-card p-4.5 shadow-2xs hover:border-primary/40 transition-all space-y-2">
            <span class="text-2xl block">{tm.icon}</span>
            <h4 class="text-xs sm:text-sm font-bold text-foreground">
              {tm.team}
            </h4>
            <p class="text-[11px] text-muted-foreground leading-relaxed">
              {tm.focus}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SECTION 8: TRANSPARENCY & FACT-CHECKING PLEDGE ──────────── -->
    <section class="rounded-2xl border border-border/80 bg-muted/20 p-6 sm:p-8 space-y-4">
      <div class="max-w-3xl space-y-1">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">
          🔍 Accountability
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Transparency & Errata Policy
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3 text-xs text-[#334155] leading-relaxed">
        <div class="space-y-1.5 rounded-xl border border-border/80 bg-card p-4">
          <h4 class="font-bold text-foreground flex items-center gap-1.5 text-xs">
            <span class="text-emerald-500">✓</span> What We Test
          </h4>
          <p class="text-[11px] text-muted-foreground">We test WireGuard configs, eBPF programs, and Noise handshakes in controlled test environments to report realistic numbers.</p>
        </div>

        <div class="space-y-1.5 rounded-xl border border-border/80 bg-card p-4">
          <h4 class="font-bold text-foreground flex items-center gap-1.5 text-xs">
            <span class="text-blue-500">✓</span> What We Know
          </h4>
          <p class="text-[11px] text-muted-foreground">We clearly delineate standardized protocols (FIPS 203 ML-KEM) from emerging proposals (draft-ietf-pquip-pqtls).</p>
        </div>

        <div class="space-y-1.5 rounded-xl border border-border/80 bg-card p-4">
          <h4 class="font-bold text-foreground flex items-center gap-1.5 text-xs">
            <span class="text-amber-500">✓</span> How We Correct Errata
          </h4>
          <p class="text-[11px] text-muted-foreground">If a community member or security researcher discovers an inaccuracy, we update the post with timestamped change logs.</p>
        </div>
      </div>
    </section>

    <!-- ── SECTION 9: RECENT ARTICLES & CALL TO ACTION ─────────────── -->
    <section class="space-y-5 pt-4 border-t border-border/70">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-foreground">
            Explore Latest Engineering Notes
          </h3>
          <p class="text-xs text-muted-foreground">Recent research papers and deployment guides</p>
        </div>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#0066ff] via-[#0088dd] to-[#00a3c4] px-4 py-1.5 text-xs font-bold text-white shadow-2xs hover:opacity-95 hover:brightness-105 transition-all"
        >
          <span>View All 45 Articles</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-3">
        {recentPosts.map((post) => {
          const slug = post.id.replace(/\.md$/, "");
          return (
            <div class="flex flex-col justify-between rounded-xl border border-border/80 bg-card p-5 shadow-2xs hover:border-primary/40 hover:shadow-xs transition-all">
              <div>
                <span class="inline-block rounded-md border border-cyan-200 bg-cyan-50 px-2 py-0.5 font-semibold text-[11px] text-cyan-700 mb-2 capitalize">
                  {post.data.category}
                </span>
                <a href={`/blog/${slug}/`} class="block group">
                  <h4 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                    {post.data.title}
                  </h4>
                </a>
                <p class="mt-1.5 text-xs text-muted-foreground line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground">
                <span>{post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                <a href={`/blog/${slug}/`} class="font-bold text-primary hover:underline">
                  Read →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </div>
</SiteLayout>
